lemma end_checked : endCheck = true := by decide +kernel

lemma no_end (D : Finset V) (hd : mask D ∈ frontier 4) (hn : BranchGraph.EdgelessAfter G D) : False := by
  have h := end_checked
  unfold endCheck at h
  have hh := List.all_eq_true.mp h (mask D) hd
  have hx : ∃ u ∉ D, ∃ v ∉ D, G.Adj u v := by simpa [mask_inv] using hh
  obtain ⟨u,hu,v,hv,he⟩ := hx
  exact hn u v hu hv he

lemma force_five {m : ℕ} (label : V → Fin m) (out : Fin m) (branches : Finset (Fin m))
    (allRoots : ∀ v : V, label v = out ∨ label v ∈ branches)
    (beforeOut : ∀ r ∈ branches, r < out)
    (goodAt : ∀ r ∈ branches, Good (BranchGroupsLean.below label r) (BranchGroupsLean.bucket label r))
    (outputIndependent : BranchGraph.Independent G (BranchGroupsLean.bucket label out)) :
    5 ≤ branches.card := by
  by_contra! small
  let roots := branches.sort
  have limit : roots.length ≤ 4 := by simpa [roots] using (show branches.card ≤ 4 by omega)
  have sorted : roots.Pairwise (· < ·) := List.sortedLT_iff_pairwise.mp (Finset.sortedLT_sort branches)
  have covers (v : V) : label v = out ∨ label v ∈ roots := by simpa [roots] using allRoots v
  have early (r) (member : r ∈ roots) : r < out := beforeOut r (by simpa [roots] using member)
  have pass : ∀ (done rest : List (Fin m)), done ++ rest = roots →
      mask (BranchGroupsLean.coveredBy label done) ∈ frontier done.length →
      mask (BranchGroupsLean.coveredBy label roots) ∈ frontier roots.length := by
    intro done rest
    induction rest generalizing done with
    | nil =>
      intro eq h
      simp only [List.append_nil] at eq
      simpa [eq] using h
    | cons r tail ih =>
      intro eq h
      have rm : r ∈ roots := eq ▸ List.mem_append_right done (by simp)
      have sorted' : (done ++ r :: tail).Pairwise (· < ·) := eq ▸ sorted
      have prev := BranchGroupsLean.covered_before_of_sorted label out done tail r sorted'
        (fun v => by simpa only [eq] using covers v) (early r rm)
      have gd := goodAt r (by simpa [roots] using rm)
      rw [← prev] at gd
      have lk : done.length < 4 := by
        have h := congrArg List.length eq
        simp only [List.length_append, List.length_cons] at h
        omega
      have hnew := advance done.length lk _ _ h (by
        intro v hv
        rw [prev]
        have bv : label v = r := by simpa [BranchGroupsLean.bucket] using hv
        simp [BranchGroupsLean.below, bv]) gd
      apply ih (done ++ [r]) (by simpa [List.append_assoc] using eq)
      simpa only [BranchGroupsLean.coveredBy_append_singleton, List.length_append, List.length_singleton] using hnew
  have initial : mask (BranchGroupsLean.coveredBy label ([] : List (Fin m))) ∈ frontier 0 := by
    simp only [BranchGroupsLean.coveredBy_nil]
    decide +kernel
  let D := BranchGroupsLean.coveredBy label roots
  have hd : mask D ∈ frontier roots.length := pass [] roots rfl initial
  have step (k : ℕ) (hk : k < 4) (h : mask D ∈ frontier k) : mask D ∈ frontier (k+1) := by
    simpa only [Finset.union_empty] using advance k hk D ∅ h (by simp) (by simp [Good])
  have pad : ∀ k, k ≤ 4 → mask D ∈ frontier k → mask D ∈ frontier 4 := by
    intro k hk h
    interval_cases k
    · exact step 3 (by decide) (step 2 (by decide) (step 1 (by decide) (step 0 (by decide) h)))
    · exact step 3 (by decide) (step 2 (by decide) (step 1 (by decide) h))
    · exact step 3 (by decide) (step 2 (by decide) h)
    · exact step 3 (by decide) h
    · exact h
  apply no_end D (pad _ limit hd)
  have hn := BranchGroupsLean.no_edges_after_branches G label out roots covers outputIndependent
  rwa [← BranchGroupsLean.coveredBy_nil label, BranchGroupsLean.removedThrough_coveredBy, List.nil_append] at hn

-- Fix the earlier vertex r. Against later supports ∅ and {t}, the three
-- current supports ∅, {u}, {v} must have three different cut bits.
lemma profile_edge {m : ℕ} (label : V → Fin m) (cut : Fin m) {r : V}
    (code : Finset V → Bool) (decode : Bool → Finset V → Prop)
    (factor : ∀ I O : Finset V, (∀ i ∈ I, label i = cut) → (∀ i ∈ O, cut < label i) →
      (BranchGraph.containsEdge G (({r} : Finset V) ∪ (I ∪ O)) ↔ decode (code I) O))
    {u v t : V} (hu : label u = cut) (hv : label v = cut) (ht : cut < label t)
    (hru : G.Adj r u) (hrv : ¬ G.Adj r v) (hvt : G.Adj v t) : G.Adj r t := by
  classical
  by_contra hrt
  have f0 := factor ∅ ∅ (by simp) (by simp)
  have fu := factor {u} ∅ (by simpa using hu) (by simp)
  have fv := factor {v} ∅ (by simpa using hv) (by simp)
  have f0t := factor ∅ {t} (by simp) (by simpa using ht)
  have fvt := factor {v} {t} (by simpa using hv) (by simpa using ht)
  have n0 : ¬ decode (code ∅) ∅ := by
    rw [← f0]
    simp [BranchGraph.containsEdge]
  have yu : decode (code {u}) ∅ := fu.mp ⟨r, by simp, u, by simp, hru⟩
  have nv : ¬ decode (code {v}) ∅ := by
    rw [← fv]
    simpa [BranchGraph.pair_contains_edge] using hrv
  have n0t : ¬ decode (code ∅) {t} := by
    rw [← f0t]
    simpa [BranchGraph.pair_contains_edge] using hrt
  have yvt : decode (code {v}) {t} := fvt.mp ⟨v, by simp, t, by simp, hvt⟩
  have ne0u : code ∅ ≠ code {u} := fun h => n0 (h.symm ▸ yu)
  have neuv : code {u} ≠ code {v} := fun h => nv (h ▸ yu)
  have ne0v : code ∅ ≠ code {v} := fun h => n0t (h.symm ▸ yvt)
  cases h0 : code ∅ <;> cases h1 : code {u} <;> cases h2 : code {v} <;>
    simp_all

lemma least_five (gs : List Gate) (o : ℕ) (least : Least 8 f gs o) :
    5 ≤ (circuitBranchWires (n := 8) gs).card := by
  classical
  letI := GDec
  have outValid : o < 8 + gs.length := by
    by_contra! bad
    obtain ⟨x, y, h⟩ := nc
    apply h
    rw [← least.hev, ← least.hev, vl_beyond gs x o bad, vl_beyond gs y o bad]
  let out : Fin (8 + gs.length) := ⟨o, outValid⟩
  have live := least_read_edge_live least nc dep res_nc outValid
  let label : V → Fin (8 + gs.length) := firstInputBoundary least.hcl out live
  let branches := circuitBranchWires (n := 8) gs
  have computes (x : V → Bool) : vl gs x out.val = PetersenScratch.edgeValue G x := by
    change vl gs x o = _
    rw [least.hev]
    apply Bool.eq_iff_iff.mpr
    simp only [f_graph, PetersenScratch.edgeValue, decide_eq_true_eq]
  have marked' (S : Finset V) : vl gs (setInput S) out.val = true ↔ BranchGraph.containsEdge G S := by
    change vl gs (setInput S) o = true ↔ _
    rw [least.hev]
    exact marked S
  have independent (r) : BranchGraph.Independent G (BranchGroupsLean.bucket label r) :=
    firstInputGroup_independent least.hcl out live (predecessors_nodup least nc) G computes alternate r
  have labels (v : V) : label v = out ∨ label v ∈ branches := by
    have stop := FirstBranchRoute.first_stops (readEdge gs) out (read_order least.hcl) live (inputWire gs v)
    rcases stop with isOut | fork
    · exact Or.inl isOut
    · exact Or.inr (in_circuit_branches.mpr fork)
  have earlier (r) (h : r ∈ branches) : r < out := by
    obtain ⟨a, _, path, _, _⟩ := in_circuit_branches.mp h
    exact lt_of_lt_of_le (read_order least.hcl path) (wire_le_output least.hcl out live a)
  apply force_five label out branches labels earlier _ (independent out)
  intro cut hc
  have prior := (earlier cut hc).le
  have terminal : FirstBranchRoute.Terminal (readEdge gs) out cut :=
    Or.inr (in_circuit_branches.mp hc)
  have twin := circuit_branch_class_twins least.hcl out live G marked' cut prior terminal (independent cut)
  refine ⟨independent cut, ?_, ?_⟩
  · intro u hu v hv au av t ht
    change t ∉ classesBefore label cut at ht
    have un : (BranchGraph.neighborsAfter G (classesBefore label cut) u).Nonempty := by
      obtain ⟨a, ha, hadj⟩ := au
      change a ∉ classesBefore label cut at ha
      exact ⟨a, by simpa only [BranchGraph.neighborsAfter, Finset.mem_filter, Finset.mem_univ, true_and]
        using And.intro hadj ha⟩
    have vn : (BranchGraph.neighborsAfter G (classesBefore label cut) v).Nonempty := by
      obtain ⟨a, ha, hadj⟩ := av
      change a ∉ classesBefore label cut at ha
      exact ⟨a, by simpa only [BranchGraph.neighborsAfter, Finset.mem_filter, Finset.mem_univ, true_and]
        using And.intro hadj ha⟩
    have eq := twin u hu v hv un vn
    change BranchGraph.neighborsAfter G (classesBefore label cut) u =
      BranchGraph.neighborsAfter G (classesBefore label cut) v at eq
    have et := Finset.ext_iff.mp eq t
    simpa [BranchGraph.neighborsAfter, ht] using et
  · intro u hu v hv _ _ r _ hru hrv t ht hi hvt
    have cutT : cut < label t := by
      have hn : ¬ label t < cut := by simpa [BranchGroupsLean.below] using ht
      have he : label t ≠ cut := by simpa [BranchGroupsLean.bucket] using hi
      exact lt_of_le_of_ne (le_of_not_gt hn) he.symm
    obtain ⟨code, decode, factors⟩ :=
      fixed_branch_bit_factor least.hcl out live cut prior terminal ({r} : Finset V)
    apply profile_edge label cut code decode (r := r) _ _ _ cutT hru hrv hvt
    · intro I O hi' ho'
      rw [← marked']
      exact factors I O hi' ho'
    · simpa [BranchGroupsLean.bucket] using hu
    · simpa [BranchGroupsLean.bucket] using hv

def witness : List Gate :=
  [⟨.or,[4,5]⟩,⟨.and,[1,8]⟩,⟨.or,[0,4]⟩,⟨.and,[7,10]⟩,⟨.or,[0,2]⟩,
   ⟨.or,[5,6]⟩,⟨.and,[12,13]⟩,⟨.or,[0,6]⟩,⟨.or,[7,15]⟩,⟨.and,[3,16]⟩,
   ⟨.or,[9,11]⟩,⟨.or,[14,17]⟩,⟨.or,[18,19]⟩]

set_option maxRecDepth 14000 in
set_option maxHeartbeats 0 in
lemma witness_eval : ∀ x : V → Bool, Circuit.eval ⟨witness,20⟩ (List.ofFn x) = f x := by decide +kernel

lemma witness_valid : ∀ g ∈ witness, (g.op = GateOp.and ∨ g.op = GateOp.or) ∧ g.inputs.length ≤ 2 := by
  simp [witness]

theorem solve (gates : List Gate) (o : ℕ)
    (basis : ∀ g ∈ gates, (g.op = GateOp.and ∨ g.op = GateOp.or ∨ g.op = GateOp.not) ∧ g.inputs.length ≤ 2)
    (_ : ∀ i j : Fin gates.length, (gates.get i).op = GateOp.not → (gates.get j).op = GateOp.not → i = j)
    (correct : ∀ x : V → Bool, Circuit.eval ⟨gates,o⟩ (List.ofFn x) = target x) :
    ∃ (gs : List Gate) (out : ℕ), (∀ g ∈ gs, (g.op = GateOp.and ∨ g.op = GateOp.or) ∧ g.inputs.length ≤ 2) ∧
      gs.length ≤ gates.length ∧ ∀ x : V → Bool, Circuit.eval ⟨gs,out⟩ (List.ofFn x) = target x := by
  classical
  have hc : HasCircuitSize 8 f gates.length :=
    ⟨⟨gates,o⟩, basis, le_rfl, fun x => (correct x).trans (f_target x).symm⟩
  obtain ⟨gs,out,least,size⟩ := exists_least 8 f gates.length nc hc
  by_cases h : ∃ g ∈ gs, g.op = GateOp.not
  · have pos := one_not_gate_positive h
    have outValid : out < 8 + gs.length := by
      by_contra! bad
      obtain ⟨x,y,hn⟩ := nc
      apply hn
      rw [← least.hev, ← least.hev, vl_beyond gs x out bad, vl_beyond gs y out bad]
    let valEmbed : Fin (8 + gs.length) ↪ Nat := ⟨Fin.val, fun _ _ eq => Fin.ext eq⟩
    let branches := (circuitBranchWires (n := 8) gs).map valEmbed
    have big : 5 ≤ branches.card := by simpa [branches] using least_five gs out least
    have used := least_wire_used least nc dep res_nc
    have double (w : Nat) (hw : w ∈ branches) :
        ∃ p q, p ≠ q ∧ Reads gs p w ∧ Reads gs q w := by
      obtain ⟨i, hi, eq⟩ := Finset.mem_map.mp hw
      exact (show i.val = w from eq) ▸ branch_slots_of_read_edges (in_circuit_branches.mp hi)
    have budget := branching_budget least.hcl outValid used branches double
    have hw : witness.length = 13 := rfl
    exact ⟨witness,20,witness_valid,by omega,fun x => (witness_eval x).trans (f_target x)⟩
  · refine ⟨gs,out,?_,size,fun x => (least.hev x).trans (f_target x)⟩
    intro g hg
    have hb : (g.op = GateOp.and ∨ g.op = GateOp.or ∨ g.op = GateOp.not) ∧ g.inputs.length ≤ 2 := by
      simpa only [Ok, Set.mem_insert_iff, Set.mem_singleton_iff] using (clean_nok 8 gs least.hcl g hg).1
    exact ⟨hb.1.elim Or.inl (fun hr => hr.elim Or.inr (fun hn => (h ⟨g,hg,hn⟩).elim)), hb.2⟩

