def c_S11 : List Nat := c_S11_0 ++ c_S11_1

theorem seg11 : ∀ a, EntriesSat a c_B11 → False :=
  checkLast_sound c_B11 14 c_S11 (by decide +kernel)

theorem unsat : ¬ FormulaSat F := fun ⟨a, ha⟩ =>
  seg11 a (seg10 a (seg9 a (seg8 a (seg7 a (seg6 a (seg5 a (seg4 a (seg3 a (seg2 a (seg1 a (seg0 a ha)))))))))))

/-- Every circuit of AND and OR gates of fan-in at most two computing the function on 7
inputs has at least 7 gates. -/
theorem lower : ∀ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C →
    (∀ x : Fin 7 → Bool, C.eval (List.ofFn x) = ((x 0 && x 3) || (x 0 && x 5) || (x 0 && x 6) || (x 1 && x 4) || (x 2 && x 3))) → 7 ≤ C.size :=
  lower_of_unsat2 7 6 fn rows (by decide) unsat

open PEqualNP.Represents

/-! ## The 3 x 4 promise: no circuit with 6 gates represents the 301 matrix -/

/-- The row of the 7-input table with left vertex `u` and right vertex `v` on. -/
def row34 (u : Fin 3) (v : Fin 4) : ℕ := 2 ^ (u : ℕ) + 2 ^ (3 + (v : ℕ))

theorem row34_eq : ∀ (u : Fin 3) (v : Fin 4),
    (List.ofFn fun i : Fin (3 + 4) => (row34 u v).testBit i) = oneEach u v := by decide

/-- The 12 rows of the representing problem, 3 vertices a side, 4 the other. -/
def rows34 : List ℕ := (List.finRange 3).flatMap fun u => (List.finRange 4).map fun v => row34 u v

theorem rows34_eq : rows34 = rows := by decide

theorem rep_lower34 (A : Fin 3 → Fin 4 → Bool) (s : ℕ) (g : ℕ → Bool)
    (hg : ∀ u v, g (row34 u v) = A u v)
    (hU : ¬ FormulaSat (enc2 (3 + 4) s g rows34)) : ¬ RepSizeAtMost A s := by
  rintro ⟨C, hC, hs, hr⟩
  have hrow : ∀ r ∈ rows34, r < 2 ^ (3 + 4) := by decide
  have := PEqualNP.Library.LRAT.Promise.promise_lower (3 + 4) s g rows34 hrow hU C hC (by
    intro r hr'
    simp only [rows34, List.mem_flatMap, List.mem_map, List.mem_finRange, true_and] at hr'
    obtain ⟨u, v, rfl⟩ := hr'
    rw [row34_eq, hr, hg])
  omega

/-- The adjacency matrix of 301 on 3 + 4 vertices. -/
def A34 : Fin 3 → Fin 4 → Bool := fun u v =>
  match u.val, v.val with
  | 0, 0 => true | 0, 1 => false | 0, 2 => true | 0, 3 => true
  | 1, 0 => false | 1, 1 => true | 1, 2 => false | 1, 3 => false
  | 2, 0 => true | 2, 1 => false | 2, 2 => false | 2, 3 => false
  | _, _ => false

theorem no_rep_6 : ¬ RepSizeAtMost (fun (u : Fin 3) (v : Fin 4) => (301 : ℕ).testBit (4 * u.val + v.val)) 6 := by
  apply rep_lower34 _ 6 (rowFun 7 fn) (by decide)
  rw [rows34_eq]
  exact unsat

