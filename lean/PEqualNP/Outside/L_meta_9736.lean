abbrev has_merge:=gR
def opp(D:qD)(a:V->Nat->qO)(x:V)(j:Nat)(y:V):Prop:=gQ D x j/\y∈fM 10 D (fC D (sem_bar (a x j)))
def lab(D:qD)(a:V->Nat->qO)(x:V)(j:Nat)(y:V):Prop:=gQ D x j/\y∈fM 10 D (fC D (a x j))
