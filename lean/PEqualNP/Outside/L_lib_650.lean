theorem ck_all : ∀ w < 2 ^ 17, chk w = true := by
  apply cover
  intro b hb
  interval_cases b
  · exact ck_0
  · exact ck_1
  · exact ck_2
  · exact ck_3
  · exact ck_4
  · exact ck_5
  · exact ck_6
  · exact ck_7

