private def select (i j : Input) : Rename := renamings (codes i j)

private def pack (f : Row → Bool) : BitVec 30 :=
  (BitVec.ofBoolListLE (List.ofFn f)).cast List.length_ofFn

private theorem packBit (f : Row → Bool) (i : Row) :
    (pack f).getLsbD i.val = f i := by
  simp only [pack, BitVec.getLsbD_cast, BitVec.getLsbD_ofBoolListLE,
    List.getD_eq_getElem?_getD, List.getElem?_ofFn]
  simp [i.isLt]

private def expected (b : Bool) := roots 0 (if b then 1 else 2)

private def check (i j : Input) : Bool :=
  let (isEdge, columnsMap, rowMap) := select i j
  (List.finRange 30).all (fun r => decide ((rowMap r).val < 15 ↔ r.val < 15)) &&
    (List.finRange 13).all fun c =>
      pack (fun r => ((roots i j).getD c.val 0).testBit (rowMap r).val) ==
      pack (fun r => ((expected isEdge).getD (columnsMap c).val 0).testBit r.val)

set_option maxRecDepth 50000 in
set_option maxHeartbeats 85000000 in
private theorem certified :
    (List.finRange 11).all (fun i => (List.finRange 11).all (check i)) = true := by
  decide +kernel

private theorem transport (i j : Input) :
    ∃ t : Bool, ∃ cs : Column → Column, ∃ rs : Row → Row,
      (∀ r, (rs r).val < 15 ↔ r.val < 15) ∧
      ∀ c r, ((roots i j).getD c.val 0).testBit (rs r).val =
        ((expected t).getD (cs c).val 0).testBit r.val := by
  have h := List.all_eq_true.mp (List.all_eq_true.mp certified i (List.mem_finRange i))
    j (List.mem_finRange j)
  generalize ex : select i j = abc at *
  obtain ⟨t, cs', rs'⟩ := abc
  simp only [check, ex, Bool.and_eq_true] at h
  refine ⟨t, cs', rs', ?_, ?_⟩
  · intro r
    exact of_decide_eq_true (List.all_eq_true.mp h.1 r (List.mem_finRange r))
  · intro c r
    have e := beq_iff_eq.mp (List.all_eq_true.mp h.2 c (List.mem_finRange c))
    have e' := congrArg (fun b : BitVec 30 => b.getLsbD r.val) e
    simpa only [packBit] using e'

