abbrev V3 := Fin 3 → ℂ
def dt (x y : V3) : ℂ := x 0 * y 0 + x 1 * y 1 + x 2 * y 2
def cC (x y : V3) : ℂ := x 0 * y 1 * y 2 + x 1 * y 2 * y 0 + x 2 * y 0 * y 1
def qQ (x y : V3) : ℂ := x 0 * y 0 * (x 0 ^ 2 - x 1 ^ 2 - x 2 ^ 2) +
  x 1 * y 1 * (x 1 ^ 2 - x 0 ^ 2 - x 2 ^ 2) + x 2 * y 2 * (x 2 ^ 2 - x 0 ^ 2 - x 1 ^ 2)
def W (a d : V3) : ℂ :=
  120 * a 0 ^ 2 * d 0 ^ 2 + 120 * a 1 ^ 2 * d 1 ^ 2 + 120 * a 2 ^ 2 * d 2 ^ 2 + (-40) * a 0 ^ 2 * d 1 ^ 2 + (-40) * a 0 ^ 2 * d 2 ^ 2 + (-40) * a 1 ^ 2 * d 0 ^ 2 + (-40) * a 1 ^ 2 * d 2 ^ 2 + (-40) * a 2 ^ 2 * d 0 ^ 2 + (-40) * a 2 ^ 2 * d 1 ^ 2 + (-160) * a 0 * a 1 * d 0 * d 1 + (-160) * a 0 * a 2 * d 0 * d 2 + (-160) * a 1 * a 2 * d 1 * d 2
def T (a b c d : V3) : ℂ :=
  (-120) * a 0 * b 0 * c 0 * d 0 + (-120) * a 1 * b 1 * c 1 * d 1 + (-120) * a 2 * b 2 * c 2 * d 2 + 40 * a 0 * b 0 * c 1 * d 1 + 40 * a 0 * b 1 * c 0 * d 1 + 40 * a 0 * b 1 * c 1 * d 0 + 40 * a 0 * b 0 * c 2 * d 2 + 40 * a 0 * b 2 * c 0 * d 2 + 40 * a 0 * b 2 * c 2 * d 0 + 40 * a 1 * b 1 * c 0 * d 0 + 40 * a 1 * b 0 * c 1 * d 0 + 40 * a 1 * b 0 * c 0 * d 1 + 40 * a 1 * b 1 * c 2 * d 2 + 40 * a 1 * b 2 * c 1 * d 2 + 40 * a 1 * b 2 * c 2 * d 1 + 40 * a 2 * b 2 * c 0 * d 0 + 40 * a 2 * b 0 * c 2 * d 0 + 40 * a 2 * b 0 * c 0 * d 2 + 40 * a 2 * b 2 * c 1 * d 1 + 40 * a 2 * b 1 * c 2 * d 1 + 40 * a 2 * b 1 * c 1 * d 2
def q2E (u a y : V3) : ℂ :=
  3 * y 0 * u 0 ^ 2 * a 0 + (-2) * y 0 * u 0 * u 1 * a 1 + (-1) * y 0 * a 0 * u 1 ^ 2 + (-2) * y 0 * u 0 * u 2 * a 2 + (-1) * y 0 * a 0 * u 2 ^ 2 + 3 * y 1 * u 1 ^ 2 * a 1 + (-2) * y 1 * u 1 * u 0 * a 0 + (-1) * y 1 * a 1 * u 0 ^ 2 + (-2) * y 1 * u 1 * u 2 * a 2 + (-1) * y 1 * a 1 * u 2 ^ 2 + 3 * y 2 * u 2 ^ 2 * a 2 + (-2) * y 2 * u 2 * u 0 * a 0 + (-1) * y 2 * a 2 * u 0 ^ 2 + (-2) * y 2 * u 2 * u 1 * a 1 + (-1) * y 2 * a 2 * u 1 ^ 2

def P2 (A B C D : V3) : ℂ := 120 * (dt A D + dt B C)
def P3 (A B C D : V3) : ℂ := 160 * (cC C A + cC A B + cC B D + cC D C)
def P4 (A B C D : V3) : ℂ :=
  -120 * (qQ A B + qQ C A + qQ B D + qQ D C) + W A D + W B C + T A B C D
def hd : V3 →ₗ[ℂ] (Fin 4 → ℂ) where
  toFun x := ![x 0 + x 1 + x 2, x 0 - x 1 - x 2, -x 0 + x 1 - x 2, -x 0 - x 1 + x 2]
  map_add' x y := by funext i; fin_cases i <;> simp <;> ring
  map_smul' c x := by funext i; fin_cases i <;> simp <;> ring
lemma hd0 (x : V3) : hd x 0 = x 0 + x 1 + x 2 := rfl
lemma hd1 (x : V3) : hd x 1 = x 0 - x 1 - x 2 := rfl
lemma hd2 (x : V3) : hd x 2 = -x 0 + x 1 - x 2 := rfl
lemma hd3 (x : V3) : hd x 3 = -x 0 - x 1 + x 2 := rfl
set_option maxRecDepth 65536 in
set_option maxHeartbeats 12000000 in
lemma expand (ζ : ℂ) (h5 : ζ ^ 5 = 1) (hΦ : ζ ^ 4 + ζ ^ 3 + ζ ^ 2 + ζ + 1 = 0)
    (X : Fin 4 → V3) :
    (∑ f : Fin 4 ↪ Fin 5, ∏ i : Fin 4,
        (1 + ∑ r : Fin 4, hd (X r) i * ζ ^ ((r.val+1)*(f i).val))) =
      120 + P2 (X 0) (X 1) (X 2) (X 3) + P3 (X 0) (X 1) (X 2) (X 3) +
        P4 (X 0) (X 1) (X 2) (X 3) := by
  have e := ie (fun i k => gs ζ (fun r => hd (X r) i) k) (fun i => gsum0 ζ h5 hΦ _)
  simp only [m2, m3, m4, mom2 ζ h5 hΦ, mom3 ζ h5 hΦ, mom4 ζ h5 hΦ] at e
  rw [show (∑ f : Fin 4 ↪ Fin 5, ∏ i : Fin 4,
        (1 + ∑ r : Fin 4, hd (X r) i * ζ ^ ((r.val+1)*(f i).val))) =
      ∑ f : Fin 4 ↪ Fin 5, ∏ i : Fin 4, (1 + gs ζ (fun r => hd (X r) i) (f i)) from rfl, e]
  simp only [M2, M3, M4, P2, P3, P4, dt, cC, qQ, W, T, hd0, hd1, hd2, hd3]
  ring
lemma pv3 (a b c : ℂ) : (![a, b, c] : V3) 0 = a := rfl
lemma pv3' (a b c : ℂ) : (![a, b, c] : V3) 1 = b := rfl
lemma pv3'' (a b c : ℂ) : (![a, b, c] : V3) 2 = c := rfl
lemma vsm (t a b c : ℂ) : t • (![a, b, c] : V3) = ![t * a, t * b, t * c] := by
  funext i; fin_cases i <;> rfl
lemma vad (a b c a' b' c' : ℂ) : (![a, b, c] : V3) + ![a', b', c'] = ![a + a', b + b', c + c'] := by
  funext i; fin_cases i <;> rfl
lemma veq (u : V3) : u = ![u 0, u 1, u 2] := by funext i; fin_cases i <;> rfl
def hv : (Fin 4 → ℂ) →ₗ[ℂ] V3 where
  toFun a := ![(a 0 + a 1 - a 2 - a 3) / 4, (a 0 - a 1 + a 2 - a 3) / 4, (a 0 - a 1 - a 2 + a 3) / 4]
  map_add' x y := by funext i; fin_cases i <;> simp <;> ring
  map_smul' c x := by funext i; fin_cases i <;> simp <;> ring
lemma hd_hv (a : Fin 4 → ℂ) (h : ∑ i, a i = 0) : hd (hv a) = a := by
  rw [Fin.sum_univ_four] at h
  funext i; fin_cases i <;> simp [hv, hd] <;> linear_combination (-1 / 4 : ℂ) * h
abbrev Q4 := Fin 4 → V3
def HR : (Fin 4 → Fin 4 → ℂ) →ₗ[ℂ] Q4 := LinearMap.pi (fun r => hv.comp (LinearMap.proj r))
def HD : Q4 →ₗ[ℂ] (Fin 4 → Fin 4 → ℂ) := LinearMap.pi (fun r => hd.comp (LinearMap.proj r))
lemma HR_apply (y : Fin 4 → Fin 4 → ℂ) (r : Fin 4) : HR y r = hv (y r) := rfl
lemma HD_apply (X : Q4) (r : Fin 4) : HD X r = hd (X r) := rfl
def q2E' (u a y : V3) : ℂ := q2E u a y
def Hyp (Q : Submodule ℂ Q4) (Uh : Submodule ℂ V3) : Prop :=
  (∀ X ∈ Q, dt (X 0) (X 3) + dt (X 1) (X 2) = 0) ∧
  (∀ X ∈ Q, ∀ u ∈ Uh, dt u (X 3) = 0) ∧
  (∀ X ∈ Q, ∀ u ∈ Uh, cC (X 2) u = 0) ∧
  (∀ X ∈ Q, ∀ u ∈ Uh, qQ u (X 1) = 0) ∧
  (∀ X ∈ Q, ∀ u ∈ Uh, W u (X 3) - 120 * q2E u (X 0) (X 1) = 0) ∧
  5 ≤ finrank ℂ Q ∧ 2 ≤ finrank ℂ Uh
lemma Hyp.fq {Q : Submodule ℂ Q4} {Uh : Submodule ℂ V3} (H : Hyp Q Uh) :
    ∀ X ∈ Q, dt (X 0) (X 3) + dt (X 1) (X 2) = 0 := H.1
lemma Hyp.fa {Q : Submodule ℂ Q4} {Uh : Submodule ℂ V3} (H : Hyp Q Uh) :
    ∀ X ∈ Q, ∀ u ∈ Uh, dt u (X 3) = 0 := H.2.1
lemma Hyp.fb {Q : Submodule ℂ Q4} {Uh : Submodule ℂ V3} (H : Hyp Q Uh) :
    ∀ X ∈ Q, ∀ u ∈ Uh, cC (X 2) u = 0 := H.2.2.1
lemma Hyp.fc {Q : Submodule ℂ Q4} {Uh : Submodule ℂ V3} (H : Hyp Q Uh) :
    ∀ X ∈ Q, ∀ u ∈ Uh, qQ u (X 1) = 0 := H.2.2.2.1
lemma Hyp.fe {Q : Submodule ℂ Q4} {Uh : Submodule ℂ V3} (H : Hyp Q Uh) :
    ∀ X ∈ Q, ∀ u ∈ Uh, W u (X 3) - 120 * q2E u (X 0) (X 1) = 0 := H.2.2.2.2.1
lemma Hyp.dq {Q : Submodule ℂ Q4} {Uh : Submodule ℂ V3} (H : Hyp Q Uh) :
    5 ≤ finrank ℂ Q := H.2.2.2.2.2.1
lemma Hyp.du {Q : Submodule ℂ Q4} {Uh : Submodule ℂ V3} (H : Hyp Q Uh) :
    2 ≤ finrank ℂ Uh := H.2.2.2.2.2.2
lemma killG {M : Type*} [AddCommGroup M] [Module ℂ M] [FiniteDimensional ℂ M]
    (X : Submodule ℂ M) {n : ℕ} (φ : M →ₗ[ℂ] (Fin n → ℂ)) (h : n < finrank ℂ X) :
    ∃ v ∈ X, v ≠ 0 ∧ φ v = 0 := by
  let ψ := φ.domRestrict X
  have h1 := LinearMap.finrank_range_add_finrank_ker ψ
  have h2 : finrank ℂ (LinearMap.range ψ) ≤ n := by
    have := Submodule.finrank_le (LinearMap.range ψ); simpa using this
  have h3 : LinearMap.ker ψ ≠ ⊥ := by
    intro e; rw [e, finrank_bot] at h1; omega
  obtain ⟨w, hw, hw0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot h3
  refine ⟨w.1, w.2, fun e => hw0 (Subtype.ext e), ?_⟩
  have : ψ w = 0 := hw
  simpa [ψ] using this
def crd (r : Fin 4) (k : Fin 3) : Q4 →ₗ[ℂ] ℂ :=
  (LinearMap.proj (R := ℂ) k : V3 →ₗ[ℂ] ℂ).comp (LinearMap.proj (R := ℂ) (φ := fun _ : Fin 4 => V3) r)
lemma kill4 (Q : Submodule ℂ Q4) (h : 5 ≤ finrank ℂ Q) (r0 r1 r2 r3 : Fin 4)
    (k0 k1 k2 k3 : Fin 3) :
    ∃ X ∈ Q, X ≠ 0 ∧ X r0 k0 = 0 ∧ X r1 k1 = 0 ∧ X r2 k2 = 0 ∧ X r3 k3 = 0 := by
  obtain ⟨X, hX, h0, e⟩ :=
    killG Q (LinearMap.pi ![crd r0 k0, crd r1 k1, crd r2 k2, crd r3 k3]) (by omega)
  refine ⟨X, hX, h0, ?_, ?_, ?_, ?_⟩
  · simpa [crd] using congrFun e 0
  · simpa [crd] using congrFun e 1
  · simpa [crd] using congrFun e 2
  · simpa [crd] using congrFun e 3
lemma kill1 (Uh : Submodule ℂ V3) (h : 2 ≤ finrank ℂ Uh) (k : Fin 3) :
    ∃ u ∈ Uh, u ≠ 0 ∧ u k = 0 := by
  obtain ⟨u, hu, h0, e⟩ := killG Uh (LinearMap.pi ![(LinearMap.proj k : V3 →ₗ[ℂ] ℂ)]) (by omega)
  exact ⟨u, hu, h0, by simpa using congrFun e 0⟩
lemma z12 (X : Q4) (h00 : X 0 0 = 0) (h01 : X 0 1 = 0) (h02 : X 0 2 = 0)
    (h10 : X 1 0 = 0) (h11 : X 1 1 = 0) (h12 : X 1 2 = 0)
    (h20 : X 2 0 = 0) (h21 : X 2 1 = 0) (h22 : X 2 2 = 0)
    (h30 : X 3 0 = 0) (h31 : X 3 1 = 0) (h32 : X 3 2 = 0) : X = 0 := by
  funext r k
  fin_cases r <;> fin_cases k
  · exact h00
  · exact h01
  · exact h02
  · exact h10
  · exact h11
  · exact h12
  · exact h20
  · exact h21
  · exact h22
  · exact h30
  · exact h31
  · exact h32
lemma z3 (u : V3) (h0 : u 0 = 0) (h1 : u 1 = 0) (h2 : u 2 = 0) : u = 0 := by
  funext k; fin_cases k
  · exact h0
  · exact h1
  · exact h2
-- the case with two coordinate axes in the plane
lemma coreS0 (Q : Submodule ℂ Q4) (Uh : Submodule ℂ V3) (H : Hyp Q Uh)
    (h0 : ![1, 0, 0] ∈ Uh) (h1 : ![0, 1, 0] ∈ Uh) : ∀ X ∈ Q, X 3 = 0 := by
  intro X hX
  have h01 : (![1, 1, 0] : V3) ∈ Uh := by
    have := Uh.add_mem h0 h1; rw [vad] at this; simpa using this
  have a0 := H.fa X hX _ h0
  have a1 := H.fa X hX _ h1
  have b2 := H.fb X hX _ h01
  have c0 := H.fc X hX _ h0
  have c1 := H.fc X hX _ h1
  have q := H.fq X hX
  have e := H.fe X hX _ h0
  simp only [dt, cC, qQ, W, q2E, pv3, pv3', pv3''] at a0 a1 b2 c0 c1 q e
  have D0 : X 3 0 = 0 := by linear_combination a0
  have D1 : X 3 1 = 0 := by linear_combination a1
  have C2 : X 2 2 = 0 := by linear_combination b2
  have B0 : X 1 0 = 0 := by linear_combination c0
  have B1 : X 1 1 = 0 := by linear_combination c1
  rw [D0, D1, C2, B0, B1] at q
  rw [D0, D1, B0, B1] at e
  have D2c : X 3 2 ^ 3 = 0 := by linear_combination (X 3 2 * e - 120 * X 1 2 * q) / (-40)
  have D2 : X 3 2 = 0 := pow_eq_zero_iff (n := 3) (by norm_num) |>.mp D2c
  exact z3 _ D0 D1 D2
-- shapes in the plane spanned by e0 and (0,1,s), s nonzero
lemma shp (Q : Submodule ℂ Q4) (Uh : Submodule ℂ V3) (H : Hyp Q Uh) (s : ℂ) (hs : s ≠ 0)
    (h0 : ![1, 0, 0] ∈ Uh) (h1 : ![0, 1, s] ∈ Uh) : ∀ X ∈ Q,
    X 3 0 = 0 ∧ X 3 1 = -s * X 3 2 ∧ X 2 0 = 0 ∧ X 2 2 = -s * X 2 1 ∧
      X 1 0 = 0 ∧ X 1 1 = -s * X 1 2 := by
  intro X hX
  have h01 : (![1, 1, s] : V3) ∈ Uh := by
    have := Uh.add_mem h0 h1; rw [vad] at this; simpa using this
  have a0 := H.fa X hX _ h0
  have a1 := H.fa X hX _ h1
  have b1 := H.fb X hX _ h1
  have b2 := H.fb X hX _ h01
  have c0 := H.fc X hX _ h0
  have c1 := H.fc X hX _ h1
  have c2 := H.fc X hX _ h01
  simp only [dt, cC, qQ, pv3, pv3', pv3''] at a0 a1 b1 b2 c0 c1 c2
  have D0 : X 3 0 = 0 := by linear_combination a0
  have C0 : X 2 0 = 0 :=
    (mul_eq_zero.mp (show s * X 2 0 = 0 by linear_combination b1)).resolve_left hs
  have B0 : X 1 0 = 0 := by linear_combination c0
  have k1 : (1 - s ^ 2) * (X 1 1 - s * X 1 2) = 0 := by linear_combination c1
  have k2 : s * (-s * X 1 1 + (s ^ 2 - 2) * X 1 2) = 0 := by linear_combination c2 + s ^ 2 * B0
  have k2' := (mul_eq_zero.mp k2).resolve_left hs
  refine ⟨D0, by linear_combination a1, C0, by linear_combination b2 - s * C0, B0, ?_⟩
  by_cases hs1 : 1 - s ^ 2 = 0
  · have : s * (X 1 1 + s * X 1 2) = 0 := by linear_combination -k2' - 2 * X 1 2 * hs1
    have := (mul_eq_zero.mp this).resolve_left hs
    linear_combination this
  · have m := (mul_eq_zero.mp k1).resolve_left hs1
    have B2z : X 1 2 = 0 := by linear_combination (k2' + s * m) / (-2)
    linear_combination m + 2 * s * B2z
lemma zq (s : ℂ) (X : Q4)
    (sh : X 3 0 = 0 ∧ X 3 1 = -s * X 3 2 ∧ X 2 0 = 0 ∧ X 2 2 = -s * X 2 1 ∧
      X 1 0 = 0 ∧ X 1 1 = -s * X 1 2)
    (h00 : X 0 0 = 0) (h01 : X 0 1 = 0) (h02 : X 0 2 = 0) (h12 : X 1 2 = 0)
    (h21 : X 2 1 = 0) (h32 : X 3 2 = 0) : X = 0 := by
  obtain ⟨D0, D1, C0, C2, B0, B1⟩ := sh
  exact z12 X h00 h01 h02 B0 (by rw [B1, h12]; ring) h12 C0 h21 (by rw [C2, h21]; ring)
    D0 (by rw [D1, h32]; ring) h32
lemma coreS1 (Q : Submodule ℂ Q4) (Uh : Submodule ℂ V3) (H : Hyp Q Uh) (s : ℂ) (hs : s ≠ 0)
    (h0 : ![1, 0, 0] ∈ Uh) (h1 : ![0, 1, s] ∈ Uh) : False := by
  have SH := shp Q Uh H s hs h0 h1
  have bil : ∀ X ∈ Q, ∀ Y ∈ Q, X 3 2 * (Y 0 2 - s * Y 0 1) + Y 3 2 * (X 0 2 - s * X 0 1) -
      2 * s * (X 1 2 * Y 2 1 + Y 1 2 * X 2 1) = 0 := by
    intro X hX Y hY
    have e := H.fq (X + Y) (Q.add_mem hX hY)
    have ex := H.fq X hX
    have ey := H.fq Y hY
    obtain ⟨x1, x2, x3, x4, x5, x6⟩ := SH X hX
    obtain ⟨y1, y2, y3, y4, y5, y6⟩ := SH Y hY
    simp only [dt, Pi.add_apply] at e ex ey
    rw [x1, x2, x3, x4, x5, x6, y1, y2, y3, y4, y5, y6] at e
    rw [x1, x2, x3, x4, x5, x6] at ex
    rw [y1, y2, y3, y4, y5, y6] at ey
    linear_combination e - ex - ey
  -- a vector with A = 0, beta = gamma = 0 and delta nonzero forces ell = 0 everywhere
  have ell : ∀ X ∈ Q, X 0 0 = 0 → X 0 1 = 0 → X 0 2 = 0 → X 1 2 = 0 → X 2 1 = 0 → X ≠ 0 →
      ∀ Y ∈ Q, Y 0 2 - s * Y 0 1 = 0 := by
    intro X hX a0 a1 a2 b c n Y hY
    have d : X 3 2 ≠ 0 := fun d => n (zq s X (SH X hX) a0 a1 a2 b c d)
    have := bil X hX Y hY
    rw [a1, a2, b, c] at this
    exact (mul_eq_zero.mp (show X 3 2 * (Y 0 2 - s * Y 0 1) = 0 by linear_combination this)).resolve_left d
  obtain ⟨X1, hX1, n1, a10, a11, a12, d1⟩ := kill4 Q H.dq 0 0 0 3 0 1 2 2
  have q1 := bil X1 hX1 X1 hX1
  rw [a11, a12, d1] at q1
  by_cases hb : X1 1 2 = 0
  · have hg : X1 2 1 ≠ 0 := fun g => n1 (zq s X1 (SH X1 hX1) a10 a11 a12 hb g d1)
    have B : ∀ Y ∈ Q, Y 1 2 = 0 := by
      intro Y hY
      have := bil X1 hX1 Y hY
      rw [a11, a12, d1, hb] at this
      have : s * X1 2 1 * Y 1 2 = 0 := by linear_combination this / (-2)
      exact (mul_eq_zero.mp this).resolve_left (mul_ne_zero hs hg)
    obtain ⟨X2, hX2, n2, a20, a21, a22, c2⟩ := kill4 Q H.dq 0 0 0 2 0 1 2 1
    have L0 := ell X2 hX2 a20 a21 a22 (B X2 hX2) c2 n2
    obtain ⟨X3, hX3, n3, a30, a31, c3, d3⟩ := kill4 Q H.dq 0 0 2 3 0 1 1 2
    have l3 := L0 X3 hX3
    rw [a31] at l3
    exact n3 (zq s X3 (SH X3 hX3) a30 a31 (by linear_combination l3) (B X3 hX3) c3 d3)
  · have hg : X1 2 1 = 0 := by
      have : s * X1 1 2 * X1 2 1 = 0 := by linear_combination q1 / (-4)
      exact (mul_eq_zero.mp this).resolve_left (mul_ne_zero hs hb)
    have G : ∀ Y ∈ Q, Y 2 1 = 0 := by
      intro Y hY
      have := bil X1 hX1 Y hY
      rw [a11, a12, d1, hg] at this
      have : s * X1 1 2 * Y 2 1 = 0 := by linear_combination this / (-2)
      exact (mul_eq_zero.mp this).resolve_left (mul_ne_zero hs hb)
    obtain ⟨X2, hX2, n2, a20, a21, a22, b2⟩ := kill4 Q H.dq 0 0 0 1 0 1 2 2
    have L0 := ell X2 hX2 a20 a21 a22 b2 (G X2 hX2) n2
    obtain ⟨X3, hX3, n3, a30, a31, b3, d3⟩ := kill4 Q H.dq 0 0 1 3 0 1 2 2
    have l3 := L0 X3 hX3
    rw [a31] at l3
    exact n3 (zq s X3 (SH X3 hX3) a30 a31 (by linear_combination l3) b3 (G X3 hX3) d3)
def pe (σ : Equiv.Perm (Fin 3)) : V3 ≃ₗ[ℂ] V3 := LinearEquiv.funCongrLeft ℂ ℂ σ
def Tp (σ : Equiv.Perm (Fin 3)) : Q4 ≃ₗ[ℂ] Q4 := LinearEquiv.piCongrRight (fun _ : Fin 4 => pe σ)
lemma Tp_apply (σ : Equiv.Perm (Fin 3)) (X : Q4) (r : Fin 4) : Tp σ X r = pe σ (X r) := rfl
lemma p01 (x : V3) : pe (Equiv.swap 0 1) x = ![x 1, x 0, x 2] := by
  funext i; fin_cases i <;> rfl
lemma p02 (x : V3) : pe (Equiv.swap 0 2) x = ![x 2, x 1, x 0] := by
  funext i; fin_cases i <;> rfl
lemma p12 (x : V3) : pe (Equiv.swap 1 2) x = ![x 0, x 2, x 1] := by
  funext i; fin_cases i <;> rfl
lemma pinv (σ : Equiv.Perm (Fin 3))
    (hσ : σ = Equiv.swap 0 1 ∨ σ = Equiv.swap 0 2 ∨ σ = Equiv.swap 1 2) (x y z : V3) :
    dt (pe σ x) (pe σ y) = dt x y ∧ cC (pe σ x) (pe σ y) = cC x y ∧
      qQ (pe σ x) (pe σ y) = qQ x y ∧ W (pe σ x) (pe σ y) = W x y ∧
      q2E (pe σ x) (pe σ y) (pe σ z) = q2E x y z := by
  rcases hσ with rfl | rfl | rfl
  · simp only [p01, dt, cC, qQ, W, q2E, pv3, pv3', pv3'']
    refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> ring
  · simp only [p02, dt, cC, qQ, W, q2E, pv3, pv3', pv3'']
    refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> ring
  · simp only [p12, dt, cC, qQ, W, q2E, pv3, pv3', pv3'']
    refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> ring
lemma trans (σ : Equiv.Perm (Fin 3))
    (hσ : σ = Equiv.swap 0 1 ∨ σ = Equiv.swap 0 2 ∨ σ = Equiv.swap 1 2)
    (Q : Submodule ℂ Q4) (Uh : Submodule ℂ V3) (H : Hyp Q Uh) :
    Hyp (Q.map (Tp σ : Q4 →ₗ[ℂ] Q4)) (Uh.map (pe σ : V3 →ₗ[ℂ] V3)) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro X hX; obtain ⟨Y, hY, rfl⟩ := Submodule.mem_map.mp hX
    simp only [LinearEquiv.coe_coe, Tp_apply]
    rw [(pinv σ hσ _ _ 0).1, (pinv σ hσ _ _ 0).1]; exact H.fq Y hY
  · intro X hX u hu; obtain ⟨Y, hY, rfl⟩ := Submodule.mem_map.mp hX
    obtain ⟨v, hv', rfl⟩ := Submodule.mem_map.mp hu
    simp only [LinearEquiv.coe_coe, Tp_apply]
    rw [(pinv σ hσ _ _ 0).1]; exact H.fa Y hY v hv'
  · intro X hX u hu; obtain ⟨Y, hY, rfl⟩ := Submodule.mem_map.mp hX
    obtain ⟨v, hv', rfl⟩ := Submodule.mem_map.mp hu
    simp only [LinearEquiv.coe_coe, Tp_apply]
    rw [(pinv σ hσ _ _ 0).2.1]; exact H.fb Y hY v hv'
  · intro X hX u hu; obtain ⟨Y, hY, rfl⟩ := Submodule.mem_map.mp hX
    obtain ⟨v, hv', rfl⟩ := Submodule.mem_map.mp hu
    simp only [LinearEquiv.coe_coe, Tp_apply]
    rw [(pinv σ hσ _ _ 0).2.2.1]; exact H.fc Y hY v hv'
  · intro X hX u hu; obtain ⟨Y, hY, rfl⟩ := Submodule.mem_map.mp hX
    obtain ⟨v, hv', rfl⟩ := Submodule.mem_map.mp hu
    simp only [LinearEquiv.coe_coe, Tp_apply]
    rw [(pinv σ hσ v (Y 3) 0).2.2.2.1, (pinv σ hσ v (Y 0) (Y 1)).2.2.2.2]
    exact H.fe Y hY v hv'
  · rw [LinearEquiv.finrank_map_eq]; exact H.dq
  · rw [LinearEquiv.finrank_map_eq]; exact H.du
lemma back (σ : Equiv.Perm (Fin 3)) (Q : Submodule ℂ Q4) (r : Fin 4)
    (h : ∀ X ∈ Q.map (Tp σ : Q4 →ₗ[ℂ] Q4), X r = 0) : ∀ X ∈ Q, X r = 0 := by
  intro X hX
  have h' : pe σ (X r) = 0 := h _ (Submodule.mem_map_of_mem hX)
  exact (LinearEquiv.map_eq_zero_iff _).mp h'
lemma scl (Uh : Submodule ℂ V3) (u : V3) (hu : u ∈ Uh) (t : ℂ) (w : V3)
    (h : ∀ i, t * u i = w i) : w ∈ Uh := by
  have e : w = t • u := funext fun i => by rw [Pi.smul_apply, smul_eq_mul, h i]
  rw [e]; exact Uh.smul_mem t hu
lemma withE0 (Q : Submodule ℂ Q4) (Uh : Submodule ℂ V3) (H : Hyp Q Uh)
    (h0 : ![1, 0, 0] ∈ Uh) : ∀ X ∈ Q, X 3 = 0 := by
  obtain ⟨v, hv, n, v0⟩ := kill1 Uh H.du 0
  by_cases h2 : v 2 = 0
  · have h1 : v 1 ≠ 0 := fun h1 => n (z3 v v0 h1 h2)
    refine coreS0 Q Uh H h0 (scl Uh v hv (v 1)⁻¹ _ fun i => ?_)
    fin_cases i
    · show (v 1)⁻¹ * v 0 = 0; rw [v0, mul_zero]
    · show (v 1)⁻¹ * v 1 = 1; exact inv_mul_cancel₀ h1
    · show (v 1)⁻¹ * v 2 = 0; rw [h2, mul_zero]
  by_cases h1 : v 1 = 0
  · have e2 : (![0, 0, 1] : V3) ∈ Uh := by
      refine scl Uh v hv (v 2)⁻¹ _ fun i => ?_
      fin_cases i
      · show (v 2)⁻¹ * v 0 = 0; rw [v0, mul_zero]
      · show (v 2)⁻¹ * v 1 = 0; rw [h1, mul_zero]
      · show (v 2)⁻¹ * v 2 = 1; exact inv_mul_cancel₀ h2
    have H' := trans (Equiv.swap 1 2) (Or.inr (Or.inr rfl)) Q Uh H
    refine back _ Q 3 (coreS0 _ _ H' ?_ ?_)
    · convert Submodule.mem_map_of_mem (f := (pe (Equiv.swap 1 2) : V3 →ₗ[ℂ] V3)) h0 using 1
      rw [LinearEquiv.coe_coe, p12]; rfl
    · convert Submodule.mem_map_of_mem (f := (pe (Equiv.swap 1 2) : V3 →ₗ[ℂ] V3)) e2 using 1
      rw [LinearEquiv.coe_coe, p12]; rfl
  · exfalso
    refine coreS1 Q Uh H (v 2 / v 1) (div_ne_zero h2 h1) h0 (scl Uh v hv (v 1)⁻¹ _ fun i => ?_)
    fin_cases i
    · show (v 1)⁻¹ * v 0 = 0; rw [v0, mul_zero]
    · show (v 1)⁻¹ * v 1 = 1; exact inv_mul_cancel₀ h1
    · show (v 1)⁻¹ * v 2 = v 2 / v 1; rw [div_eq_inv_mul]
lemma core (Q : Submodule ℂ Q4) (Uh : Submodule ℂ V3) (H : Hyp Q Uh) :
    (∀ X ∈ Q, X 2 = 0) ∨ (∀ X ∈ Q, X 3 = 0) := by
  by_cases e0 : (![1, 0, 0] : V3) ∈ Uh
  · exact Or.inr (withE0 Q Uh H e0)
  by_cases e1 : (![0, 1, 0] : V3) ∈ Uh
  · right
    have H' := trans (Equiv.swap 0 1) (Or.inl rfl) Q Uh H
    refine back _ Q 3 (withE0 _ _ H' ?_)
    convert Submodule.mem_map_of_mem (f := (pe (Equiv.swap 0 1) : V3 →ₗ[ℂ] V3)) e1 using 1
    rw [LinearEquiv.coe_coe, p01]; rfl
  by_cases e2 : (![0, 0, 1] : V3) ∈ Uh
  · right
    have H' := trans (Equiv.swap 0 2) (Or.inr (Or.inl rfl)) Q Uh H
    refine back _ Q 3 (withE0 _ _ H' ?_)
    convert Submodule.mem_map_of_mem (f := (pe (Equiv.swap 0 2) : V3 →ₗ[ℂ] V3)) e2 using 1
    rw [LinearEquiv.coe_coe, p02]; rfl
  left
  intro X hX
  have c0 : X 2 0 = 0 := by
    obtain ⟨u, hu, n, u0⟩ := kill1 Uh H.du 0
    have hb := H.fb X hX u hu
    simp only [cC] at hb; rw [u0] at hb
    have p : u 1 ≠ 0 := by
      intro p; apply e2; refine scl Uh u hu (u 2)⁻¹ _ fun i => ?_
      have q : u 2 ≠ 0 := fun q => n (z3 u u0 p q)
      fin_cases i
      · show (u 2)⁻¹ * u 0 = 0; rw [u0, mul_zero]
      · show (u 2)⁻¹ * u 1 = 0; rw [p, mul_zero]
      · show (u 2)⁻¹ * u 2 = 1; exact inv_mul_cancel₀ q
    have q : u 2 ≠ 0 := by
      intro q; apply e1; refine scl Uh u hu (u 1)⁻¹ _ fun i => ?_
      fin_cases i
      · show (u 1)⁻¹ * u 0 = 0; rw [u0, mul_zero]
      · show (u 1)⁻¹ * u 1 = 1; exact inv_mul_cancel₀ p
      · show (u 1)⁻¹ * u 2 = 0; rw [q, mul_zero]
    exact (mul_eq_zero.mp (show X 2 0 * (u 1 * u 2) = 0 by linear_combination hb)).resolve_right
      (mul_ne_zero p q)
  have c1 : X 2 1 = 0 := by
    obtain ⟨u, hu, n, u1⟩ := kill1 Uh H.du 1
    have hb := H.fb X hX u hu
    simp only [cC] at hb; rw [u1] at hb
    have p : u 0 ≠ 0 := by
      intro p; apply e2; refine scl Uh u hu (u 2)⁻¹ _ fun i => ?_
      have q : u 2 ≠ 0 := fun q => n (z3 u p u1 q)
      fin_cases i
      · show (u 2)⁻¹ * u 0 = 0; rw [p, mul_zero]
      · show (u 2)⁻¹ * u 1 = 0; rw [u1, mul_zero]
      · show (u 2)⁻¹ * u 2 = 1; exact inv_mul_cancel₀ q
    have q : u 2 ≠ 0 := by
      intro q; apply e0; refine scl Uh u hu (u 0)⁻¹ _ fun i => ?_
      fin_cases i
      · show (u 0)⁻¹ * u 0 = 1; exact inv_mul_cancel₀ p
      · show (u 0)⁻¹ * u 1 = 0; rw [u1, mul_zero]
      · show (u 0)⁻¹ * u 2 = 0; rw [q, mul_zero]
    exact (mul_eq_zero.mp (show X 2 1 * (u 2 * u 0) = 0 by linear_combination hb)).resolve_right
      (mul_ne_zero q p)
  have c2 : X 2 2 = 0 := by
    obtain ⟨u, hu, n, u2⟩ := kill1 Uh H.du 2
    have hb := H.fb X hX u hu
    simp only [cC] at hb; rw [u2] at hb
    have p : u 0 ≠ 0 := by
      intro p; apply e1; refine scl Uh u hu (u 1)⁻¹ _ fun i => ?_
      have q : u 1 ≠ 0 := fun q => n (z3 u p q u2)
      fin_cases i
      · show (u 1)⁻¹ * u 0 = 0; rw [p, mul_zero]
      · show (u 1)⁻¹ * u 1 = 1; exact inv_mul_cancel₀ q
      · show (u 1)⁻¹ * u 2 = 0; rw [u2, mul_zero]
    have q : u 1 ≠ 0 := by
      intro q; apply e0; refine scl Uh u hu (u 0)⁻¹ _ fun i => ?_
      fin_cases i
      · show (u 0)⁻¹ * u 0 = 1; exact inv_mul_cancel₀ p
      · show (u 0)⁻¹ * u 1 = 0; rw [q, mul_zero]
      · show (u 0)⁻¹ * u 2 = 0; rw [u2, mul_zero]
    exact (mul_eq_zero.mp (show X 2 2 * (u 0 * u 1) = 0 by linear_combination hb)).resolve_right
      (mul_ne_zero p q)
  exact z3 _ c0 c1 c2
lemma hom (t : ℂ) (A B C D : V3) :
    P2 (t • A) (t • B) (t • C) (t • D) = t ^ 2 * P2 A B C D ∧
      P3 (t • A) (t • B) (t • C) (t • D) = t ^ 3 * P3 A B C D ∧
      P4 (t • A) (t • B) (t • C) (t • D) = t ^ 4 * P4 A B C D := by
  refine ⟨?_, ?_, ?_⟩ <;>
    simp only [P2, P3, P4, dt, cC, qQ, W, T, Pi.smul_apply, smul_eq_mul] <;> ring
lemma algA (A B C D u : V3) : P2 (A + (1 : ℂ) • u) B C D - P2 A B C D = 120 * dt u D := by
  simp only [P2, dt, Pi.add_apply, Pi.smul_apply, smul_eq_mul]; ring
lemma algB (A B C D u : V3) : P3 (A + (1 : ℂ) • u) B C D + P3 (A + (-1 : ℂ) • u) B C D -
    2 * P3 A B C D = 320 * cC C u := by
  simp only [P3, cC, Pi.add_apply, Pi.smul_apply, smul_eq_mul]; ring
lemma algC (A B C D u : V3) : P4 (A + (2 : ℂ) • u) B C D - P4 (A + (-2 : ℂ) • u) B C D -
    2 * P4 (A + (1 : ℂ) • u) B C D + 2 * P4 (A + (-1 : ℂ) • u) B C D = -1440 * qQ u B := by
  simp only [P4, qQ, W, T, Pi.add_apply, Pi.smul_apply, smul_eq_mul]; ring
lemma algE (A B C D u : V3) : P4 (A + (1 : ℂ) • u) B C D + P4 (A + (-1 : ℂ) • u) B C D -
    2 * P4 A B C D = 2 * (W u D - 120 * q2E u A B) := by
  simp only [P4, qQ, W, T, q2E, Pi.add_apply, Pi.smul_apply, smul_eq_mul]; ring
def pv (u : V3) : Q4 := fun r => if r = 0 then u else 0
lemma pvs (X : Q4) (c : ℂ) (u : V3) : (X + c • pv u) 0 = X 0 + c • u ∧
    (X + c • pv u) 1 = X 1 ∧ (X + c • pv u) 2 = X 2 ∧ (X + c • pv u) 3 = X 3 := by
  simp [pv]
lemma mkHyp (Q : Submodule ℂ Q4) (Uh : Submodule ℂ V3)
    (Pz : ∀ X ∈ Q, P2 (X 0) (X 1) (X 2) (X 3) + P3 (X 0) (X 1) (X 2) (X 3) +
      P4 (X 0) (X 1) (X 2) (X 3) = 0)
    (pure : ∀ u ∈ Uh, pv u ∈ Q) (dq : 5 ≤ finrank ℂ Q) (du : 2 ≤ finrank ℂ Uh) : Hyp Q Uh := by
  have Pk : ∀ X ∈ Q, P2 (X 0) (X 1) (X 2) (X 3) = 0 ∧ P3 (X 0) (X 1) (X 2) (X 3) = 0 ∧
      P4 (X 0) (X 1) (X 2) (X 3) = 0 := by
    intro X hX
    have e1 := Pz _ (Q.smul_mem (1 : ℂ) hX)
    have e2 := Pz _ (Q.smul_mem (-1 : ℂ) hX)
    have e3 := Pz _ (Q.smul_mem (2 : ℂ) hX)
    simp only [Pi.smul_apply] at e1 e2 e3
    rw [(hom _ _ _ _ _).1, (hom _ _ _ _ _).2.1, (hom _ _ _ _ _).2.2] at e1 e2 e3
    refine ⟨?_, ?_, ?_⟩
    · linear_combination e1 - (e1 - e2) / 2 - (e3 - 6 * e1 + 2 * e2) / 12
    · linear_combination (e1 - e2) / 2
    · linear_combination (e3 - 6 * e1 + 2 * e2) / 12
  have at' : ∀ X ∈ Q, ∀ u ∈ Uh, ∀ c : ℂ,
      P2 (X 0 + c • u) (X 1) (X 2) (X 3) = 0 ∧ P3 (X 0 + c • u) (X 1) (X 2) (X 3) = 0 ∧
      P4 (X 0 + c • u) (X 1) (X 2) (X 3) = 0 := by
    intro X hX u hu c
    have := Pk _ (Q.add_mem hX (Q.smul_mem c (pure u hu)))
    obtain ⟨p0, p1, p2, p3⟩ := pvs X c u
    rw [p0, p1, p2, p3] at this
    exact this
  refine ⟨fun X hX => ?_, fun X hX u hu => ?_, fun X hX u hu => ?_, fun X hX u hu => ?_,
    fun X hX u hu => ?_, dq, du⟩
  · have := (Pk X hX).1; unfold P2 at this; linear_combination this / 120
  · have := algA (X 0) (X 1) (X 2) (X 3) u
    rw [(at' X hX u hu 1).1, (Pk X hX).1] at this
    linear_combination this / (-120)
  · have := algB (X 0) (X 1) (X 2) (X 3) u
    rw [(at' X hX u hu 1).2.1, (at' X hX u hu (-1)).2.1, (Pk X hX).2.1] at this
    linear_combination this / (-320)
  · have := algC (X 0) (X 1) (X 2) (X 3) u
    rw [(at' X hX u hu 1).2.2, (at' X hX u hu (-1)).2.2, (at' X hX u hu 2).2.2,
      (at' X hX u hu (-2)).2.2] at this
    linear_combination this / 1440
  · have := algE (X 0) (X 1) (X 2) (X 3) u
    rw [(at' X hX u hu 1).2.2, (at' X hX u hu (-1)).2.2, (Pk X hX).2.2] at this
    linear_combination this / (-2)
lemma main : ∀ (ζ : ℂ), IsPrimitiveRoot ζ 5 →
  ∀ (L : Submodule ℂ (Fin 4 → Fin 4 → ℂ)) (U : Submodule ℂ (Fin 4 → ℂ)),
    (∀ x ∈ L, (∀ r : Fin 4, (∑ i, x r i) = 0) ∧
      (∑ f : Fin 4 ↪ Fin 5, ∏ i : Fin 4,
        (1 + ∑ r : Fin 4, x r i * ζ ^ ((r.val+1)*(f i).val))) = 120) →
    (∀ u ∈ U, (fun r : Fin 4 => if r = 0 then u else 0) ∈ L) →
    2 ≤ Module.finrank ℂ U → 5 ≤ Module.finrank ℂ L →
      (∀ x ∈ L, x 2 = 0) ∨ (∀ x ∈ L, x 3 = 0) := by
  intro ζ hζ L U hL hU hdU hdL
  have h5 : ζ ^ 5 = 1 := hζ.pow_eq_one
  have hΦ : ζ ^ 4 + ζ ^ 3 + ζ ^ 2 + ζ + 1 = 0 := by
    have := hζ.geom_sum_eq_zero (by norm_num : 1 < 5)
    simp [Finset.sum_range_succ] at this
    linear_combination this
  have rs : ∀ x ∈ L, ∀ r, ∑ i, x r i = 0 := fun x hx => (hL x hx).1
  have Pz : ∀ X ∈ L.map HR, P2 (X 0) (X 1) (X 2) (X 3) + P3 (X 0) (X 1) (X 2) (X 3) +
      P4 (X 0) (X 1) (X 2) (X 3) = 0 := by
    intro X hX
    obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.mp hX
    have e := expand ζ h5 hΦ (HR y)
    have key : ∀ r i, hd (HR y r) i = y r i := fun r i => by rw [HR_apply, hd_hv _ (rs y hy r)]
    simp only [key] at e
    have := (hL y hy).2
    linear_combination this - e
  have pure : ∀ u ∈ U.map hv, pv u ∈ L.map HR := by
    intro u hu
    obtain ⟨v, hv', rfl⟩ := Submodule.mem_map.mp hu
    refine ⟨_, hU v hv', funext fun r => ?_⟩
    by_cases h : r = 0 <;> simp [HR_apply, pv, h]
  have dq : 5 ≤ finrank ℂ (L.map HR) := by
    have le : L ≤ (L.map HR).map HD := fun x hx =>
      ⟨HR x, Submodule.mem_map_of_mem hx, funext fun r => hd_hv _ (rs x hx r)⟩
    have := Submodule.finrank_mono le
    have := Submodule.finrank_map_le HD (L.map HR)
    omega
  have du : 2 ≤ finrank ℂ (U.map hv) := by
    have le : U ≤ (U.map hv).map hd := fun u hu => by
      have s0 := (hL _ (hU u hu)).1 0
      simp only [if_pos rfl] at s0
      exact ⟨hv u, Submodule.mem_map_of_mem hu, hd_hv u s0⟩
    have := Submodule.finrank_mono le
    have := Submodule.finrank_map_le hd (U.map hv)
    omega
  have H := mkHyp _ _ Pz pure dq du
  rcases core _ _ H with h | h
  · left; intro x hx
    have h' : hv (x 2) = 0 := h (HR x) (Submodule.mem_map_of_mem hx)
    rw [← hd_hv (x 2) (rs x hx 2), h', map_zero]
  · right; intro x hx
    have h' : hv (x 3) = 0 := h (HR x) (Submodule.mem_map_of_mem hx)
    rw [← hd_hv (x 3) (rs x hx 3), h', map_zero]
end
end PEqualNP.Outside.L_gct_284
open PEqualNP.Outside.L_gct_284 in
theorem PEqualNP.Outside.L_gct_284 : ∀ (ζ : ℂ), IsPrimitiveRoot ζ 5 →
  ∀ (L : Submodule ℂ (Fin 4 → Fin 4 → ℂ)) (U : Submodule ℂ (Fin 4 → ℂ)),
    (∀ x ∈ L, (∀ r : Fin 4, (∑ i, x r i) = 0) ∧
      (∑ f : Fin 4 ↪ Fin 5, ∏ i : Fin 4,
        (1 + ∑ r : Fin 4, x r i * ζ ^ ((r.val+1)*(f i).val))) = 120) →
    (∀ u ∈ U, (fun r : Fin 4 => if r = 0 then u else 0) ∈ L) →
    2 ≤ Module.finrank ℂ U → 5 ≤ Module.finrank ℂ L →
      (∀ x ∈ L, x 2 = 0) ∨ (∀ x ∈ L, x 3 = 0) :=
  main
