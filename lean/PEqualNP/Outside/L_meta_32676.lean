def PM (s j : Nat) : Nat := let k := fld (pmB s (j / 128)) 6 (j % 128); fld (pmPalB (k / 32)) 15 (k % 32)
def mkPools (s i : Nat) : List (Nat × Nat × (Nat × List Nat)) :=
  let pm := PM s i
  if pm == 0 then [] else
    let ops := PO s i
    (if pm.testBit 0 then [(dom_250,10,runOps true dom_250 (0,roots_250) ops)] else [])++(if pm.testBit 1 then [(dom_219,9,runOps true dom_219 (0,roots_219) ops)] else [])++(if pm.testBit 2 then [(dom_235,9,runOps true dom_235 (0,roots_235) ops)] else [])++(if pm.testBit 3 then [(dom_123,10,runOps true dom_123 (0,roots_123) ops)] else [])++(if pm.testBit 4 then [(dom_217,5,runOps true dom_217 (0,roots_217) ops)] else [])++(if pm.testBit 5 then [(dom_233,5,runOps true dom_233 (0,roots_233) ops)] else [])++(if pm.testBit 6 then [(dom_107,7,runOps true dom_107 (0,roots_107) ops)] else [])++(if pm.testBit 7 then [(dom_249,8,runOps true dom_249 (0,roots_249) ops)] else [])++(if pm.testBit 8 then [(dom_187,10,runOps true dom_187 (0,roots_187) ops)] else [])++(if pm.testBit 9 then [(dom_202,4,runOps true dom_202 (0,roots_202) ops)] else [])++(if pm.testBit 10 then [(dzo_243_8,9,runOps true dzo_243_8 (0,roots_243) ops)] else [])++(if pm.testBit 11 then [(dom_243,9,runOps true dom_243 (0,roots_243) ops)] else [])++(if pm.testBit 12 then [(dom_121,7,runOps true dom_121 (0,roots_121) ops)] else [])++(if pm.testBit 13 then [(dom_203,5,runOps true dom_203 (0,roots_203) ops)] else [])++(if pm.testBit 14 then [(dom_185,7,runOps true dom_185 (0,roots_185) ops)] else [])
def mkCut (s i : Nat) (g : Nat × Nat × Nat) (zs : List Nat) : Bool := (mkPools s i).any fun e => checkPool true e.1 e.2.1 (s - 1) (stepOp true e.1 e.2.2 g) zs
theorem mkCut_sound {s i g ys} (h : mkCut (s + 1) i g ys = true) : ¬ RunD true dom_251 goalM s ys := by
  unfold mkCut mkPools at h; dsimp only at h
  split at h
  · simp at h
  · rw [List.any_eq_true] at h
    obtain ⟨e, he, hchk⟩ := h
    simp only [List.mem_append, List.mem_ite_nil_right, List.mem_singleton, or_assoc] at he
    rcases he with ⟨_,rfl⟩|⟨_,rfl⟩|⟨_,rfl⟩|⟨_,rfl⟩|⟨_,rfl⟩|⟨_,rfl⟩|⟨_,rfl⟩|⟨_,rfl⟩|⟨_,rfl⟩|⟨_,rfl⟩|⟨_,rfl⟩|⟨_,rfl⟩|⟨_,rfl⟩|⟨_,rfl⟩|⟨_,rfl⟩
    · exact cpcs (by decide +kernel) lowS_250 _ g hchk
    · exact cpcs (by decide +kernel) lowS_219 _ g hchk
    · exact cpcs (by decide +kernel) lowS_235 _ g hchk
    · exact cpcs (by decide +kernel) lowS_123 _ g hchk
    · exact cpcs (by decide +kernel) lowS_217 _ g hchk
    · exact cpcs (by decide +kernel) lowS_233 _ g hchk
    · exact cpcs (by decide +kernel) lowS_107 _ g hchk
    · exact cpcs (by decide +kernel) lowS_249 _ g hchk
    · exact cpcs (by decide +kernel) lowS_187 _ g hchk
    · exact cpcs (by decide +kernel) lowS_202 _ g hchk
    · exact cpcs (by decide +kernel) lowS_zo_243_8_178 _ g hchk
    · exact cpcs (by decide +kernel) lowS_243 _ g hchk
    · exact cpcs (by decide +kernel) lowS_121 _ g hchk
    · exact cpcs (by decide +kernel) lowS_203 _ g hchk
    · exact cpcs (by decide +kernel) lowS_185 _ g hchk
