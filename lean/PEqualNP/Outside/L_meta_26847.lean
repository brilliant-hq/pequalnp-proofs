lemma advance (k : ℕ) (hk : k < 4) (D I : Finset V) (hD : mask D ∈ frontier k)
    (hi : ∀ i ∈ I, i ∉ D) (hg : Good D I) : mask (D ∪ I) ∈ frontier (k+1) := by
  have hd : D ⊆ D ∪ I := Finset.subset_union_left
  have he : (D ∪ I) \ D = I := by
    ext i
    simp only [Finset.mem_sdiff, Finset.mem_union]
    constructor
    · rintro ⟨h | h, hn⟩
      · exact (hn h).elim
      · exact h
    · intro h
      exact ⟨Or.inr h, hi i h⟩
  have h := frontier_checked k hk (mask D) hD
  unfold checkStep at h
  have hh := List.all_eq_true.mp h (mask (D ∪ I)) (by simp)
  by_contra hbad
  have hs : subsetB (mask D) (mask (D ∪ I)) = true :=
    (subsetB_true _ _).mpr (by simpa only [mask_inv] using hd)
  have hb : (frontierBits (k+1)).testBit (mask (D ∪ I)).val = false := by
    apply Bool.eq_false_iff.mpr
    exact fun h => hbad ((frontier_bit ⟨k+1, by omega⟩ _).mp h)
  simpa [hs, hb, mask_inv, he, goodB_of D I hg] using hh

def endCheck : Bool :=
  letI := GDec
  (frontier 4).all fun d => !(decide (∀ u v : V, u ∉ maskSet d → v ∉ maskSet d → ¬ G.Adj u v))

