import Mathlib
import PEqualNP.Defs

set_option maxRecDepth 4096 in
set_option maxHeartbeats 1000000 in
theorem PEqualNP.Outside.R_meta_949_2
    (hCircuit : ∃ t : ℕ, t < 155 ∧
      let d := ( : ℕ) / 262144 ^ t % 262144
      let G := SimpleGraph.fromRel (fun a b : Fin 6 => a < b ∧ (d / 8).testBit ((([0, 4, 7, 9, 10, 10] : List ℕ).getD a.val 0 + b.val) - 1) = true)
      ∃ C : PEqualNP.AndCount.AndCountCircuit 6, C.WellFormed ∧ C.size < d % 8 ∧
        (∀ I : Finset (Fin 6), (∀ v ∈ I, ∀ w ∈ I, ¬ G.Adj v w) →
        (∀ u, u ∉ I → ∃ v ∈ I, G.Adj u v) →
        C.eval I = false ∧ ∀ u, u ∉ I → C.eval (insert u I) = true))
    (hCover : ∀ t : ℕ, t < 155 →
      let d := ( : ℕ) / 262144 ^ t % 262144
      let G := SimpleGraph.fromRel (fun a b : Fin 6 => a < b ∧ (d / 8).testBit ((([0, 4, 7, 9, 10, 10] : List ℕ).getD a.val 0 + b.val) - 1) = true)
      ∀ (k : ℕ) (X Y : Fin k → Finset (Fin 6)),
        (∀ i : Fin k, ∀ a ∈ X i, ∀ b ∈ Y i, G.Adj a b) →
        (∀ a b : Fin 6, G.Adj a b → ∃ i : Fin k, (a ∈ X i ∧ b ∈ Y i) ∨ (b ∈ X i ∧ a ∈ Y i)) → d % 8 ≤ k) :
    ∃ (G : SimpleGraph (Fin 6)) (C : PEqualNP.AndCount.AndCountCircuit 6),
      C.WellFormed ∧ (∀ I : Finset (Fin 6), (∀ v ∈ I, ∀ w ∈ I, ¬ G.Adj v w) →
        (∀ u, u ∉ I → ∃ v ∈ I, G.Adj u v) →
        C.eval I = false ∧ ∀ u, u ∉ I → C.eval (insert u I) = true) ∧
      ¬ (∃ (k : ℕ) (X Y : Fin k → Finset (Fin 6)), k ≤ C.size ∧
        (∀ i : Fin k, ∀ a ∈ X i, ∀ b ∈ Y i, G.Adj a b) ∧
        (∀ a b : Fin 6, G.Adj a b → ∃ i : Fin k, (a ∈ X i ∧ b ∈ Y i) ∨ (b ∈ X i ∧ a ∈ Y i))) := by
  obtain ⟨t, ht, C, hWF, hsize, hpartial⟩ := hCircuit
  let d := ( : ℕ) / 262144 ^ t % 262144
  let G := SimpleGraph.fromRel (fun a b : Fin 6 => a < b ∧ (d / 8).testBit ((([0, 4, 7, 9, 10, 10] : List ℕ).getD a.val 0 + b.val) - 1) = true)
  refine ⟨G, C, hWF, hpartial, ?_⟩
  rintro ⟨k, X, Y, hk, hrect, hcov⟩
  have hmin : d % 8 ≤ k := hCover t ht k X Y hrect hcov
  exact (not_lt_of_ge (le_trans hmin hk)) hsize
