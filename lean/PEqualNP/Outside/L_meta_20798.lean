noncomputable def drain (W M : Nat) (k : Nat → Nat → List Nat) (fuel a n : Nat) : List Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → List Nat) (fun a n => k a n)
    (fun _ ih a n =>
      Bool.rec (k a n) (Nat.land a M :: ih (Nat.shiftRight a W) (Nat.sub n W)) (Nat.ble W n))
    fuel a n

noncomputable def fields (W : Nat) (ws : List Nat) : List Nat :=
  List.rec (motive := fun _ => Nat → Nat → List Nat) (fun _ _ => [])
    (fun w _ ih a n =>
      force (Nat.lor a (Nat.shiftLeft w n)) fun b =>
        force (Nat.add n 64) fun j => drain W (Nat.sub (Nat.shiftLeft 1 W) 1) ih 70 b j)
    ws 0 0

noncomputable def mk (B : Nat) (l : List Nat) (k : Nat → Nat → List Nat) : Nat → Nat → List Nat :=
  List.rec (motive := fun _ => Nat → Nat → List Nat) (fun a j => k a j)
    (fun x _ ih a j =>
      force (Nat.lor a (Nat.shiftLeft x j)) fun b =>
        force (Nat.add j B) fun i => Bool.rec (ih b i) (b :: ih 0 0) (Nat.beq i 5120))
    l

noncomputable def nth (l : List Nat) : Nat → Nat :=
  List.rec (motive := fun _ => Nat → Nat) (fun _ => 0)
    (fun h _ ih i => Nat.rec (motive := fun _ => Nat) h (fun p _ => ih p) i) l

noncomputable def ex (T : List Nat) (nt fuel : Nat) : Nat → List Nat → List Nat :=
  Nat.rec (motive := fun _ => Nat → List Nat → List Nat) (fun _ rest => rest)
    (fun _ ih s rest =>
      force (Nat.land (Nat.shiftRight (nth T (Nat.shiftRight s 7)) (Nat.mul (Nat.land s 127) 40))
          1099511627775) fun e =>
        Bool.rec (e :: rest)
          (ih (Nat.sub (Nat.shiftRight e 20) 1) (ih (Nat.land e 1048575) rest))
          (Nat.ble nt s))
    fuel

noncomputable def expand (T : List Nat) (nt : Nat) (body : List Nat) : List Nat :=
  List.rec (motive := fun _ => List Nat) [] (fun s _ ih => ex T nt 64 s ih) body

