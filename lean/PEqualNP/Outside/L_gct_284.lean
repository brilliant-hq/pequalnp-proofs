lemma ie (G : Fin 4 → Fin 5 → ℂ) (hG : ∀ i, ∑ k, G i k = 0) :
    (∑ f : Fin 4 ↪ Fin 5, ∏ i, (1 + G i (f i))) = 120 -
      6 * (m2 G 0 1 + m2 G 0 2 + m2 G 0 3 + m2 G 1 2 + m2 G 1 3 + m2 G 2 3) +
      4 * (m3 G 0 1 2 + m3 G 0 1 3 + m3 G 0 2 3 + m3 G 1 2 3) - 6 * m4 G +
      (m2 G 0 1 * m2 G 2 3 + m2 G 0 2 * m2 G 1 3 + m2 G 0 3 * m2 G 1 2) := by
  have h4 : ∀ i, G i 4 = -(G i 0 + G i 1 + G i 2 + G i 3) := fun i => by
    have := hG i; rw [Fin.sum_univ_five] at this; linear_combination this
  have e := sumEmb (fun i k => 1 + G i k)
  try simp only at e
  rw [e]
  simp (config := {decide := true}) only [Fin.sum_univ_five, ite_true, ite_false, add_zero, zero_add]
  simp only [m2, m3, m4, Fin.sum_univ_five]
  simp only [h4]
  ring
def gs (ζ : ℂ) (v : Fin 4 → ℂ) (k : Fin 5) : ℂ := ∑ r : Fin 4, v r * ζ ^ ((r.val + 1) * k.val)
lemma gv (ζ : ℂ) (h5 : ζ ^ 5 = 1) (v : Fin 4 → ℂ) :
    gs ζ v 0 = v 0 + v 1 + v 2 + v 3 ∧
    gs ζ v 1 = v 0 * ζ + v 1 * ζ ^ 2 + v 2 * ζ ^ 3 + v 3 * ζ ^ 4 ∧
    gs ζ v 2 = v 0 * ζ ^ 2 + v 1 * ζ ^ 4 + v 2 * ζ + v 3 * ζ ^ 3 ∧
    gs ζ v 3 = v 0 * ζ ^ 3 + v 1 * ζ + v 2 * ζ ^ 4 + v 3 * ζ ^ 2 ∧
    gs ζ v 4 = v 0 * ζ ^ 4 + v 1 * ζ ^ 3 + v 2 * ζ ^ 2 + v 3 * ζ := by
  have zr : ∀ r q : ℕ, ζ ^ (r + 5 * q) = ζ ^ r := fun r q => by
    rw [pow_add, pow_mul, h5, one_pow, mul_one]
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> rw [gs, Fin.sum_univ_four]
  · show v 0 * ζ ^ (1 * 0) + v 1 * ζ ^ (2 * 0) + v 2 * ζ ^ (3 * 0) + v 3 * ζ ^ (4 * 0) = _
    ring
  · show v 0 * ζ ^ (1 * 1) + v 1 * ζ ^ (2 * 1) + v 2 * ζ ^ (3 * 1) + v 3 * ζ ^ (4 * 1) = _
    ring
  · show v 0 * ζ ^ (1 * 2) + v 1 * ζ ^ (2 * 2) + v 2 * ζ ^ (3 * 2) + v 3 * ζ ^ (4 * 2) = _
    rw [show 3 * 2 = 1 + 5 * 1 from rfl, show 4 * 2 = 3 + 5 * 1 from rfl, zr, zr]; ring
  · show v 0 * ζ ^ (1 * 3) + v 1 * ζ ^ (2 * 3) + v 2 * ζ ^ (3 * 3) + v 3 * ζ ^ (4 * 3) = _
    rw [show 2 * 3 = 1 + 5 * 1 from rfl, show 3 * 3 = 4 + 5 * 1 from rfl,
      show 4 * 3 = 2 + 5 * 2 from rfl, zr, zr, zr]; ring
  · show v 0 * ζ ^ (1 * 4) + v 1 * ζ ^ (2 * 4) + v 2 * ζ ^ (3 * 4) + v 3 * ζ ^ (4 * 4) = _
    rw [show 2 * 4 = 3 + 5 * 1 from rfl, show 3 * 4 = 2 + 5 * 2 from rfl,
      show 4 * 4 = 1 + 5 * 3 from rfl, zr, zr, zr]; ring
lemma gsum0 (ζ : ℂ) (h5 : ζ ^ 5 = 1) (hΦ : ζ ^ 4 + ζ ^ 3 + ζ ^ 2 + ζ + 1 = 0)
    (v : Fin 4 → ℂ) : ∑ k, gs ζ v k = 0 := by
  obtain ⟨g0, g1, g2, g3, g4⟩ := gv ζ h5 v
  rw [Fin.sum_univ_five, g0, g1, g2, g3, g4]
  linear_combination (v 0 + v 1 + v 2 + v 3) * hΦ
