import Mathlib
import PEqualNP.Defs

namespace PEqualNP.Outside.L_lib_650

def rot (s word : Nat) : Nat := ((word <<< (s % 17)) ||| (word >>> (17 - s % 17))) % 2 ^ 17

def step (word : Nat) : Nat :=
  (List.range 17).foldl (fun acc b =>
    acc ||| ((xor (word.testBit b)
      (!(word.testBit ((b + 1) % 17)) && word.testBit ((b + 2) % 17))).toNat <<< b)) 0

def fstep (w : Nat) : Nat :=
  (w &&& (2 ^ 17 - 1)) ^^^ (((2 ^ 17 - 1) ^^^
    ((((w &&& (2 ^ 17 - 1)) >>> 1) ||| ((w &&& (2 ^ 17 - 1)) <<< 16)) &&& (2 ^ 17 - 1))) &&&
    ((((w &&& (2 ^ 17 - 1)) >>> 2) ||| ((w &&& (2 ^ 17 - 1)) <<< 15)) &&& (2 ^ 17 - 1)))

def outputW (st : Nat → Nat) (w : Nat) : Nat :=
  ((List.range 4).foldl (fun x t =>
    st (x ^^^ rot 1 x ^^^ rot (17 - 1) x) ^^^ rot (2 * t) w ^^^
      (3 ^ (17 + (t + 1)) % 2 ^ 17)) (rot 1 w)) >>> 8

def passW (st : Nat → Nat) (key name : Nat) : Nat :=
  (List.range 4).foldl (fun state j =>
    st (state ^^^ rot 2 state ^^^ rot (17 - 2) state) ^^^
      rot (3 * (j + 1) + 1) key ^^^ (3 ^ (17 + (4 + (j + 1))) % 2 ^ 17))
    (rot 3 key ^^^ name)

def parB (mask word : Nat) : Bool :=
  ((List.range 17).filter (fun i => mask.testBit i && word.testBit i)).length % 2 == 1

theorem fold_bit (g : Nat → Bool) (i : Nat) : ∀ n,
    ((List.range n).foldl (fun acc b => acc ||| (g b).toNat <<< b) 0).testBit i =
      (decide (i < n) && g i) := by
  intro n
  induction n with
  | zero => simp
  | succ n ih =>
    rw [List.range_succ, List.foldl_append, List.foldl_cons, List.foldl_nil, Nat.testBit_or, ih]
    by_cases hin : i = n
    · subst hin
      cases g i <;> simp [Nat.testBit_shiftLeft]
    · cases hg : g n
      · simp only [Bool.toNat_false, Nat.zero_shiftLeft, Nat.zero_testBit, Bool.or_false]
        by_cases h : i < n
        · simp [h, show i < n + 1 by omega]
        · simp [h, show ¬ i < n + 1 by omega]
      · rw [Bool.toNat_true, Nat.one_shiftLeft, Nat.testBit_two_pow]
        have hni : ¬ n = i := fun e => hin e.symm
        by_cases h : i < n
        · simp [h, hni, show i < n + 1 by omega]
        · simp [h, hni, show ¬ i < n + 1 by omega]

theorem step_bit (w i : Nat) : (step w).testBit i = (decide (i < 17) && xor (w.testBit i)
    (!(w.testBit ((i + 1) % 17)) && w.testBit ((i + 2) % 17))) :=
  fold_bit (fun b => xor (w.testBit b)
    (!(w.testBit ((b + 1) % 17)) && w.testBit ((b + 2) % 17))) i 17

theorem step_eq (w : Nat) : step w = fstep w := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [step_bit]
  have hm : ∀ j, Nat.testBit 131071 j = decide (j < 17) := fun j => by
    simpa using Nat.testBit_two_pow_sub_one 17 j
  unfold fstep
  by_cases hi : i < 17
  · interval_cases i <;> simp [-Nat.testBit_zero, hm, Nat.testBit_xor, Nat.testBit_and,
      Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft]
  · simp [hi, hm, Nat.testBit_xor, Nat.testBit_and]

theorem cnt_xor (m a b : Nat) : ∀ n,
    ((List.range n).filter (fun i => m.testBit i && (a ^^^ b).testBit i)).length % 2 =
      (((List.range n).filter (fun i => m.testBit i && a.testBit i)).length +
        ((List.range n).filter (fun i => m.testBit i && b.testBit i)).length) % 2 := by
  intro n
  induction n with
  | zero => simp
  | succ n ih =>
    simp only [List.range_succ, List.filter_append, List.length_append, List.filter_cons,
      List.filter_nil]
    rw [Nat.testBit_xor]
    cases m.testBit n <;> cases a.testBit n <;> cases b.testBit n <;>
      simp [-Nat.testBit_xor] <;> omega

theorem parB_xor (m a b : Nat) : parB m (a ^^^ b) = xor (parB m a) (parB m b) := by
  unfold parB
  rw [cnt_xor]
  rcases Nat.mod_two_eq_zero_or_one
    ((List.range 17).filter (fun i => m.testBit i && a.testBit i)).length with h1 | h1 <;>
  rcases Nat.mod_two_eq_zero_or_one
    ((List.range 17).filter (fun i => m.testBit i && b.testBit i)).length with h2 | h2 <;>
  simp [Nat.add_mod, h1, h2]

theorem parB_zero (m : Nat) : parB m 0 = false := by
  unfold parB
  simp

theorem parB_fold (m : Nat) (f : Nat × Nat → Nat) : ∀ l : List (Nat × Nat),
    parB m ((l.map f).foldr (· ^^^ ·) 0) = (l.map (fun p => parB m (f p))).foldr xor false := by
  intro l
  induction l with
  | nil => simp [parB_zero]
  | cons p l ih => simp [parB_xor, ih]

theorem fold_const (v : Bool) : ∀ bs : List Bool, (∀ b ∈ bs, b = v) →
    bs.foldr xor false = (decide (bs.length % 2 = 1) && v) := by
  intro bs
  induction bs with
  | nil => simp
  | cons b bs ih =>
    intro h
    rw [List.foldr_cons, ih (fun x hx => h x (List.mem_cons_of_mem _ hx)),
      h b List.mem_cons_self, List.length_cons]
    cases v
    · simp
    · by_cases hp : bs.length % 2 = 1
      · simp [hp, show ¬ (bs.length + 1) % 2 = 1 by omega]
      · simp [hp, show (bs.length + 1) % 2 = 1 by omega]

theorem odd_kill (g : Bool → Bool) (bs : List Bool) (hodd : bs.length % 2 = 1)
    (hall : ∀ b ∈ bs, g b = false) : g (bs.foldr xor false) = false := by
  cases hF : g false <;> cases hT : g true
  · cases bs.foldr xor false <;> assumption
  · have : ∀ b ∈ bs, b = false := fun b hb => by
      cases b
      · rfl
      · rw [hall _ hb] at hT
        exact absurd hT (by simp)
    rw [fold_const false bs this]
    simpa using hF
  · have : ∀ b ∈ bs, b = true := fun b hb => by
      cases b
      · rw [hall _ hb] at hF
        exact absurd hF (by simp)
      · rfl
    rw [fold_const true bs this]
    simpa [hodd] using hT
  · exfalso
    cases bs with
    | nil => simp at hodd
    | cons b bs =>
      have := hall b List.mem_cons_self
      cases b
      · rw [this] at hF
        exact absurd hF (by simp)
      · rw [this] at hT
        exact absurd hT (by simp)

theorem key_kill (g : Bool → Bool) (m : Nat) (l : List (Nat × Nat)) (hodd : l.length % 2 = 1)
    (hall : ∀ p ∈ l, g (parB m (p.2 ^^^ 12)) = false) :
    g (parB m ((l.map (fun p => p.2 ^^^ 12)).foldr (· ^^^ ·) 0)) = false := by
  rw [parB_fold]
  apply odd_kill
  · simpa using hodd
  · intro b hb
    obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hb
    exact hall p hp

