abbrev V := Fin 8

def edges : List (V × V) :=
  [(0,3),(1,4),(0,5),(1,5),(2,5),(0,6),(2,6),(3,6),(0,7),(3,7),(4,7)]

def adj (a b : V) : Bool := (![232,48,96,193,130,7,13,25] : V → ℕ) a |>.testBit b.val

def G : SimpleGraph V where
  Adj a b := adj a b = true
  symm := ⟨by decide +kernel⟩
  loopless := ⟨by decide +kernel⟩

def GDec : DecidableRel G.Adj := fun a b => inferInstanceAs (Decidable (adj a b = true))

def f (x : V → Bool) : Bool := edges.any fun e => x e.1 && x e.2

def data : List ℕ := [0, 3, 1, 4, 0, 5, 1, 5, 2, 5, 0, 6, 2, 6, 3, 6, 0, 7, 3, 7, 4, 7]

def target (x : V → Bool) : Bool := decide (∃ i < data.length / 2,
  (List.ofFn x).getD (data.getD (2 * i) 0) false = true ∧
  (List.ofFn x).getD (data.getD (2 * i + 1) 0) false = true)

set_option maxRecDepth 12000 in
set_option maxHeartbeats 0 in
lemma f_target : ∀ x, f x = target x := by decide +kernel

lemma nc : ∃ x y, f x ≠ f y := ⟨fun _ => false, fun _ => true, by decide +kernel⟩

set_option maxRecDepth 12000 in
set_option maxHeartbeats 0 in
lemma dep : ∀ i, Dep f i := by unfold Dep; decide +kernel

lemma res_nc (i : V) (b : Bool) : ∃ x y, f (Function.update x i b) ≠ f (Function.update y i b) := by
  refine ⟨fun _ => false, fun _ => true, ?_⟩
  exact (show ∀ (i : V) (b : Bool), f (Function.update (fun _ => false) i b) ≠
    f (Function.update (fun _ => true) i b) by decide +kernel) i b

set_option maxRecDepth 12000 in
set_option maxHeartbeats 0 in
lemma f_graph : ∀ x : V → Bool, f x =
    (letI := GDec; decide (∃ u v, G.Adj u v ∧ x u = true ∧ x v = true)) := by
  decide +kernel

lemma marked (S : Finset V) : f (setInput S) = true ↔ BranchGraph.containsEdge G S := by
  letI := GDec
  rw [f_graph, decide_eq_true_eq]
  constructor
  · rintro ⟨u,v,h,hu,hv⟩
    exact ⟨u, by simpa [setInput] using hu, v, by simpa [setInput] using hv, h⟩
  · rintro ⟨u,hu,v,hv,h⟩
    exact ⟨u,v,h,by simpa [setInput] using hu,by simpa [setInput] using hv⟩

lemma alternate : ∀ i j, G.Adj i j → ∃ u v, G.Adj i u ∧ G.Adj j v ∧ u ≠ j ∧ v ≠ i ∧ ¬ G.Adj u v := by
  letI := GDec
  decide

-- A cut bucket is independent. Its nonisolated vertices have the same later
-- neighbors, and an earlier vertex can distinguish two of them only by
-- covering the later neighbors. The last test uses three distinct profiles.
def Good (D I : Finset V) : Prop := (∀ u ∈ I, ∀ v ∈ I, ¬ G.Adj u v) ∧
  (∀ u ∈ I, ∀ v ∈ I,
    (∃ t : V, t ∉ D ∧ G.Adj u t) → (∃ t : V, t ∉ D ∧ G.Adj v t) →
    ∀ t : V, t ∉ D → (G.Adj u t ↔ G.Adj v t)) ∧
  (∀ u ∈ I, ∀ v ∈ I,
    (∃ t : V, t ∉ D ∧ G.Adj u t) → (∃ t : V, t ∉ D ∧ G.Adj v t) →
    ∀ r ∈ D, G.Adj r u → ¬ G.Adj r v → ∀ t : V,
      t ∉ D → t ∉ I → G.Adj v t → G.Adj r t)

def maskSet (d : Fin 256) : Finset V := Finset.univ.filter fun i => d.val.testBit i.val

def mask (S : Finset V) : Fin 256 := Fin.ofNat 256 (∑ i ∈ S, 2 ^ i.val)


def allV (p : V → Bool) : Bool := (List.finRange 8).all p
def anyV (p : V → Bool) : Bool := (List.finRange 8).any p
def bimp (a b : Bool) : Bool := !a || b

lemma allV_true (p : V → Bool) : allV p = true ↔ ∀ v, p v = true := by
  simp [allV, List.all_eq_true]

lemma anyV_true (p : V → Bool) : anyV p = true ↔ ∃ v, p v = true := by
  simp [anyV, List.any_eq_true]

lemma bimp_true (a b : Bool) : bimp a b = true ↔ (a = true → b = true) := by
  cases a <;> cases b <;> decide

lemma neg_true (a : Bool) : (!a) = true ↔ ¬ (a = true) := by cases a <;> decide

lemma adj_true (u v : V) : adj u v = true ↔ G.Adj u v := Iff.rfl

lemma adj_eq (u v t : V) : adj u t = adj v t ↔ (G.Adj u t ↔ G.Adj v t) :=
  Bool.eq_iff_iff

def goodB (D I : Finset V) : Bool :=
  let mem := fun v => decide (v ∈ I)
  let earlier := fun v => decide (v ∈ D)
  let active := fun u => anyV fun t => !earlier t && adj u t
  (allV fun u => bimp (mem u) (allV fun v => bimp (mem v) (!adj u v))) &&
  (allV fun u => bimp (mem u) (allV fun v => bimp (mem v)
    (bimp (active u) (bimp (active v) (allV fun t => bimp (!earlier t)
      (decide (adj u t = adj v t))))))) &&
  (allV fun u => bimp (mem u) (allV fun v => bimp (mem v)
    (bimp (active u) (bimp (active v) (allV fun r => bimp (earlier r)
      (bimp (adj r u) (bimp (!adj r v) (allV fun t => bimp (!earlier t)
        (bimp (!mem t) (bimp (adj v t) (adj r t)))))))))))

