def fanB (C : Circuit) : Bool :=
  C.gates.all fun g => PEqualNP.Library.Helpers.Replay.isAONB g.op && decide (g.inputs.length ≤ 2)

theorem fanB_sound (C : Circuit) (h : fanB C = true) : PEqualNP.MetaComplexity.FanInTwo C := by
  intro g hg
  have hh : PEqualNP.Library.Helpers.Replay.isAONB g.op = true ∧ decide (g.inputs.length ≤ 2) = true := by
    simpa only [Bool.and_eq_true] using (List.all_eq_true.mp h g hg)
  constructor
  · cases hop : g.op <;> simp_all [PEqualNP.Library.Helpers.Replay.isAONB]
  · exact of_decide_eq_true hh.2

def Mem : ℕ → Type
  | 0 => ℕ
  | d + 1 => Mem d × Mem d

def rd : (d : ℕ) → Mem d → ℕ → ℕ
  | 0, v, i => if i = 0 then v else 0
  | d + 1, t, i => if i % 2 = 0 then rd d t.1 (i / 2) else rd d t.2 (i / 2)

def wr : (d : ℕ) → Mem d → ℕ → ℕ → Mem d
  | 0, v, i, x => if i = 0 then x else v
  | d + 1, t, i, x =>
      if i % 2 = 0 then (wr d t.1 (i / 2) x, t.2) else (t.1, wr d t.2 (i / 2) x)

theorem rd_wr {d : ℕ} (t : Mem d) (i j x : ℕ) :
    rd d (wr d t i x) j = if j = i ∧ i < 2 ^ d then x else rd d t j := by
  induction d generalizing i j with
  | zero =>
    by_cases hi : i = 0 <;> by_cases hj : j = 0 <;>
      simp [rd, wr, hi, hj] <;> omega
  | succ d ih =>
    change Mem d × Mem d at t
    rcases t with ⟨l,r⟩
    have hp : 2 ^ (d + 1) = 2 * 2 ^ d := by rw [pow_succ]; omega
    by_cases hi : i % 2 = 0 <;> by_cases hj : j % 2 = 0
    · simp only [wr, rd, hi, hj, ↓reduceIte, Prod.fst, Prod.snd]
      rw [ih]
      have he : (j / 2 = i / 2 ∧ i / 2 < 2 ^ d) ↔ (j = i ∧ i < 2 ^ (d + 1)) := by
        rw [hp]; omega
      simp only [he]
    · have hne : j ≠ i := by omega
      simp [wr, rd, hi, hj, hne]
    · have hne : j ≠ i := by omega
      simp [wr, rd, hi, hj, hne]
    · simp only [wr, rd, hi, hj, ↓reduceIte, Prod.fst, Prod.snd]
      rw [ih]
      have he : (j / 2 = i / 2 ∧ i / 2 < 2 ^ d) ↔ (j = i ∧ i < 2 ^ (d + 1)) := by
        rw [hp]; omega
      simp only [he]

def fill : (d : ℕ) → (ℕ → ℕ) → Mem d
  | 0, f => f 0
  | d + 1, f => (fill d (fun i => f (2 * i)), fill d (fun i => f (2 * i + 1)))

theorem rd_fill (d : ℕ) (f : ℕ → ℕ) (i : ℕ) :
    rd d (fill d f) i = if i < 2 ^ d then f i else 0 := by
  induction d generalizing f i with
  | zero =>
    by_cases hi : i = 0 <;> simp [fill, rd, hi] <;> omega
  | succ d ih =>
    have hp : 2 ^ (d + 1) = 2 * 2 ^ d := by rw [pow_succ]; omega
    by_cases hi : i % 2 = 0
    · simp only [fill, rd, hi, ite_true]
      rw [ih]
      have he : 2 * (i / 2) = i := by omega
      have hb : i / 2 < 2 ^ d ↔ i < 2 ^ (d + 1) := by rw [hp]; omega
      simp only [he, hb]
    · simp only [fill, rd, hi, ite_false]
      rw [ih]
      have he : 2 * (i / 2) + 1 = i := by omega
      have hb : i / 2 < 2 ^ d ↔ i < 2 ^ (d + 1) := by rw [hp]; omega
      simp only [he, hb]

def tgate {d : ℕ} (N : ℕ) (g : Gate) (t : Mem d) : ℕ :=
  match g.op with
  | .and => (g.inputs.map fun a => rd d t a).foldr (· &&& ·) (mask N)
  | .or => (g.inputs.map fun a => rd d t a).foldr (· ||| ·) 0
  | .not => mask N ^^^ (g.inputs.map fun a => rd d t a).headD 0
  | _ => 0

def Agree {d : ℕ} (t : Mem d) (cs : List ℕ) : Prop := ∀ i, rd d t i = cs.getD i 0

theorem tgate_eq {d : ℕ} (N : ℕ) (g : Gate) (t : Mem d) (cs : List ℕ) (h : Agree t cs) :
    tgate N g t = gateCol N g cs := by
  have he : rd d t = fun i => cs.getD i 0 := funext h
  cases g with
  | mk op inputs => cases op <;> simp [tgate, gateCol, he]

theorem agree_push {d : ℕ} (t : Mem d) (cs : List ℕ) (h : Agree t cs)
    (hc : cs.length < 2 ^ d) (x : ℕ) : Agree (wr d t cs.length x) (cs ++ [x]) := by
  intro i
  rw [rd_wr]
  by_cases hi : i = cs.length
  · subst i
    simp [hc, List.getD_append_right]
  · simp only [hi, false_and, ite_false]
    rw [h i]
    by_cases hl : i < cs.length
    · exact (List.getD_append _ _ _ _ hl).symm
    · rw [List.getD_eq_default _ _ (by omega), List.getD_eq_default _ _ (by simp; omega)]

def trun {d : ℕ} (N : ℕ) : List Gate → ℕ → Mem d → Mem d
  | [], _, t => t
  | g :: gs, pos, t => trun N gs (pos + 1) (wr d t pos (tgate N g t))

theorem trun_agree {d : ℕ} (N : ℕ) (gs : List Gate) (t : Mem d) (cs : List ℕ)
    (h : Agree t cs) (hc : cs.length + gs.length ≤ 2 ^ d) :
    Agree (trun N gs cs.length t) (gs.foldl (fun a g => a ++ [gateCol N g a]) cs) := by
  induction gs generalizing t cs with
  | nil => exact h
  | cons g gs ih =>
    simp only [trun, List.foldl_cons]
    rw [tgate_eq N g t cs h]
    have ha := agree_push t cs h (by simp only [List.length_cons] at hc; omega) (gateCol N g cs)
    simpa only [List.length_append, List.length_singleton] using
      ih (wr d t cs.length (gateCol N g cs)) (cs ++ [gateCol N g cs]) ha (by simp_all; omega)

def tcols (d N : ℕ) (C : Circuit) (n m : ℕ) : Mem d :=
  trun N C.gates (n + m) (fill d (fun i => ((inCols n m).toArray)[i]?.getD 0))

theorem tcols_agree (d N : ℕ) (C : Circuit) (n m : ℕ) (hc : n + m + C.size ≤ 2 ^ d) :
    Agree (tcols d N C n m) (pcols N C n m) := by
  have hi : Agree (fill d (fun i => ((inCols n m).toArray)[i]?.getD 0)) (inCols n m) := by
    intro i
    rw [rd_fill]
    by_cases h : i < 2 ^ d
    · simp [h, List.getD_eq_getElem?_getD]
    · rw [if_neg h, List.getD_eq_default _ _ (by simp [inCols]; omega)]
  have hl : (inCols n m).length = n + m := by simp [inCols]
  simpa only [tcols, pcols, hl] using trun_agree N C.gates _ (inCols n m) hi (by simpa [hl, Circuit.size] using hc)

theorem trep {n m N d : ℕ} (hN : n * m ≤ 2 ^ N) (C : Circuit) (rows : List ℕ)
    (hc : n + m + C.size ≤ 2 ^ d) (hrows : ∀ r ∈ rows, r < 2 ^ m) (hg : aonB C = true)
    (h : (rd d (tcols d N C n m) C.output == tcol m rows) = true) :
    PEqualNP.Represents.Represents (fun (u : Fin n) (v : Fin m) => (rows.getD u.val 0).testBit v.val) C := by
  apply represents_of_pcols hN C rows hrows hg
  rw [← tcols_agree d N C n m hc C.output]
  exact h

