namespace S_49
def pG:List (Nat×Nat):=[(1,17),(1,33),(16,17),(16,48),(32,33),(32,48)]
def r1G:=pG.map Prod.fst
def r2G:=pG.map Prod.snd
def mpG:=0x3f
