lemma frontier_bit : ∀ (k : Fin 5) (d : Fin 256),
    (frontierBits k.val).testBit d.val = true ↔ d ∈ frontier k.val := by decide +kernel

def subsetB (d e : Fin 256) : Bool :=
  allV fun i => bimp (d.val.testBit i.val) (e.val.testBit i.val)

lemma subsetB_true (d e : Fin 256) : subsetB d e = true ↔ maskSet d ⊆ maskSet e := by
  simp [subsetB, allV_true, bimp_true, Finset.subset_iff, maskSet]

def checkStep (k : ℕ) (d : Fin 256) : Bool :=
  let D := maskSet d
  (List.finRange 256).all fun e =>
    let I := maskSet e \ D
    !(subsetB d e) || (frontierBits (k+1)).testBit e.val || !(goodB D I)

