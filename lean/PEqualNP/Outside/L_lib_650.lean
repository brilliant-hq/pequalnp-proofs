open PEqualNP.Outside.L_lib_650 in
theorem PEqualNP.Outside.L_lib_650 :
let k : Nat := 17
let rot := fun (s word : Nat) =>
  ((word <<< (s % k)) ||| (word >>> (k - s % k))) % 2 ^ k
let step := fun (word : Nat) =>
  (List.range k).foldl (fun acc b =>
    acc ||| ((xor (word.testBit b)
      (!(word.testBit ((b + 1) % k)) && word.testBit ((b + 2) % k))).toNat <<< b)) 0
let output := fun (w : Nat) =>
  ((List.range 4).foldl (fun x t =>
    step (x ^^^ rot 1 x ^^^ rot (k - 1) x) ^^^ rot (2 * t) w ^^^
      (3 ^ (k + (t + 1)) % 2 ^ k)) (rot 1 w)) >>> 8
let columnPass := fun (key name : Nat) =>
  ((List.range 4).foldl (fun state j =>
    step (state ^^^ rot 2 state ^^^ rot (k - 2) state) ^^^
      rot (3 * (j + 1) + 1) key ^^^ (3 ^ (k + (4 + (j + 1))) % 2 ^ k))
    (rot 3 key ^^^ name)) < 2 ^ 8
let keys := List.range (2 ^ k)
let edge := fun (column : Nat) => ∃ w ∈ keys, output w = 0 ∧ columnPass w column
let parity := fun (mask word : Nat) =>
  ((List.range k).filter (fun i => mask.testBit i && word.testBit i)).length % 2 == 1
∀ (query : Nat → Fin (2 ^ k)) (lookup : Nat → Bool → Bool),
  let predicted := fun (column : Nat) =>
    ∃ w ∈ keys,
      (if w.testBit 2 then output w = 0
       else
         let probe := w ^^^ 12
         let y := output probe
         lookup y (parity (query y).val probe) = true) ∧ columnPass w column
  edge 0 ∧ (¬predicted 0 ∨ ∃ c : Fin (2 ^ k), ¬edge c.val ∧ predicted c.val) := by
  show ∀ (query : Nat → Fin (2 ^ 17)) (lookup : Nat → Bool → Bool),
    (∃ w ∈ List.range (2 ^ 17), outputW step w = 0 ∧ passW step w 0 < 2 ^ 8) ∧
    (¬ (∃ w ∈ List.range (2 ^ 17),
        (if w.testBit 2 then outputW step w = 0
         else lookup (outputW step (w ^^^ 12))
           (parB (query (outputW step (w ^^^ 12))).val (w ^^^ 12)) = true) ∧
        passW step w 0 < 2 ^ 8) ∨
      ∃ c : Fin (2 ^ 17),
        ¬ (∃ w ∈ List.range (2 ^ 17), outputW step w = 0 ∧ passW step w c.val < 2 ^ 8) ∧
        (∃ w ∈ List.range (2 ^ 17),
          (if w.testBit 2 then outputW step w = 0
           else lookup (outputW step (w ^^^ 12))
             (parB (query (outputW step (w ^^^ 12))).val (w ^^^ 12)) = true) ∧
          passW step w c.val < 2 ^ 8))
  rw [show step = fstep from funext step_eq]
  intro query lookup
  have hZ : ∀ w < 2 ^ 17, outputW fstep w = 0 →
      (∀ c ∈ negs, ¬ passW fstep w c < 2 ^ 8) ∧
        (w.testBit 2 = true → ¬ passW fstep w 0 < 2 ^ 8) := by
    intro w hw h0
    have := ck_all w hw
    simp only [chk, h0, beq_self_eq_true, Bool.not_true, Bool.false_or, Bool.and_eq_true,
      List.all_eq_true, Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not] at this
    refine ⟨this.2.1, fun hb => ?_⟩
    rcases this.2.2 with h | h
    · simp [hb] at h
    · exact h
  refine ⟨⟨11632, List.mem_range.2 (by norm_num), wit.1, wit.2⟩, ?_⟩
  by_cases hn : ∃ c ∈ negs, ∃ w ∈ List.range (2 ^ 17), w.testBit 2 = false ∧
      passW fstep w c < 2 ^ 8 ∧ lookup (outputW fstep (w ^^^ 12))
        (parB (query (outputW fstep (w ^^^ 12))).val (w ^^^ 12)) = true
  · obtain ⟨c, hc, w, hw, hb, hp, hl⟩ := hn
    refine Or.inr ⟨⟨c, negs_lt c hc⟩, ?_, ⟨w, hw, by rw [if_neg (by simp [hb])]; exact hl, hp⟩⟩
    rintro ⟨v, hv, ho, hpv⟩
    exact (hZ v (List.mem_range.1 hv) ho).1 c hc hpv
  · refine Or.inl ?_
    rintro ⟨w, hw, hif, hp⟩
    split_ifs at hif with hb
    · exact (hZ w (List.mem_range.1 hw) hif).2 hb hp
    · have h0 := ck_all w (List.mem_range.1 hw)
      simp only [chk, Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true',
        decide_eq_false_iff_not] at h0
      obtain ⟨h0, -⟩ := h0
      rcases h0 with (h0 | h0) | h0
      · exact h0 hp
      · exact hb h0
      obtain ⟨t, ht, hte⟩ := List.any_eq_true.1 h0
      have hte' : t.1 = w := by simpa using hte
      obtain ⟨hx, hodd, hall⟩ := tab_ok t ht
      rw [hte'] at hx hall
      have hk := key_kill (lookup (outputW fstep (w ^^^ 12)))
        (query (outputW fstep (w ^^^ 12))).val t.2 hodd (fun p hp' => by
          obtain ⟨hpc, hlt, hb2, ho, hpp⟩ := hall p hp'
          cases hq : lookup (outputW fstep (w ^^^ 12))
            (parB (query (outputW fstep (w ^^^ 12))).val (p.2 ^^^ 12))
          · rfl
          · exact absurd ⟨p.1, hpc, p.2, List.mem_range.2 hlt, hb2, hpp, by rw [ho]; exact hq⟩ hn)
      rw [← hx] at hk
      rw [hk] at hif
      exact absurd hif (by simp)
