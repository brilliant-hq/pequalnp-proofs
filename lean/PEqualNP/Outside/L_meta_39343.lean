lemma ir : ∀ e ∈ rt, Imp [] e.1 e.2 := apI (apI i1 i2) i3
noncomputable section cachePieces

abbrev CacheStateFn := Nat → Nat → Nat → List W → Bool
abbrev CacheTest := Nat → CacheStateFn

def HitSound (hit original : CacheTest) : Prop :=
  ∀ fuel k t z v, hit fuel k t z v = true → original fuel k t z v = false

structure CacheKey where
  fuel : Nat
  k : Nat
  t : Nat
  z : Nat
  wires : List W

def cacheWireEq (a b : W) : Bool :=
  a.s == b.s && a.a == b.a && a.b == b.b && a.c == b.c && a.r == b.r

theorem cacheWireEq_iff (a b : W) : cacheWireEq a b = true ↔ a = b := by
  cases a
  cases b
  simp [cacheWireEq, Bool.and_eq_true, and_assoc]

def cacheWiresEq : List W → List W → Bool
  | [], [] => true
  | a :: as, b :: bs => cacheWireEq a b && cacheWiresEq as bs
  | _, _ => false

theorem cacheWiresEq_iff (a b : List W) : cacheWiresEq a b = true ↔ a = b := by
  induction a generalizing b with
  | nil => cases b <;> simp [cacheWiresEq]
  | cons a as ih => cases b <;> simp [cacheWiresEq, cacheWireEq_iff, ih]

def cacheMatch (q : CacheKey) (fuel k t z : Nat) (w : List W) : Bool :=
  q.fuel == fuel && q.k == k && q.t == t && q.z == z && cacheWiresEq q.wires w

def hitKeys (keys : List CacheKey) : CacheTest :=
  fun fuel k t z w => keys.any (fun q => cacheMatch q fuel k t z w)

theorem hitKeys_sound (keys : List CacheKey) (original : CacheTest)
    (h : ∀ q ∈ keys, original q.fuel q.k q.t q.z q.wires = false) :
    HitSound (hitKeys keys) original := by
  intro fuel k t z w hw
  obtain ⟨q, hq, eq⟩ := List.any_eq_true.mp hw
  simp only [cacheMatch, Bool.and_eq_true, beq_iff_eq, cacheWiresEq_iff] at eq
  obtain ⟨⟨⟨⟨a,b⟩,c⟩,d⟩,e⟩ := eq
  simpa only [← a, ← b, ← c, ← d, ← e] using h q hq

noncomputable def cacheStep (l m g : Nat) (ih : CacheStateFn) : CacheStateFn :=
  fun k t z v => Bool.rec (motive := fun _ => Bool) (tst (pos t) l (Nat.sub (Nat.succ k) t) v (fun y => mv ih l m g k t z v y)) true (Nat.ble v.length 1)

noncomputable def cacheStep1 (l m g : Nat) (ordinary ih : CacheStateFn) : CacheStateFn :=
  fun k t z v => Bool.rec (motive := fun _ => Bool) (tst (pos t) l (Nat.sub (Nat.succ k) t) v (fun y =>
      Bool.rec (motive := fun _ => Bool) (mv ordinary l m g k t z v y) true
        (node (ih (Nat.sub k 1) t) (pos t) l m g (Nat.sub (Nat.sub k t) y) v.length z v pairsS))) true (Nat.ble v.length 1)

noncomputable def cacheRun (hit : CacheTest) (step : CacheStateFn → CacheStateFn) : CacheTest
  | 0 => fun _ _ _ _ => true
  | fuel + 1 => fun k t z v =>
    if hit (fuel + 1) k t z v = true then false else step (cacheRun hit step fuel) k t z v

theorem cacheRun_eq (hit original : CacheTest) (step : CacheStateFn → CacheStateFn)
    (zero : original 0 = fun _ _ _ _ => true)
    (succ : ∀ n, original (n+1) = step (original n))
    (sound : HitSound hit original) : cacheRun hit step = original := by
  funext fuel
  induction fuel with
  | zero => exact zero.symm
  | succ n ih =>
    funext k t z v
    by_cases h : hit (n+1) k t z v = true
    · simpa only [cacheRun, ite_eq_left h] using (sound _ _ _ _ _ h).symm
    · simp only [cacheRun, ite_eq_right h, ih, succ n]

noncomputable def lookMemo (hit : CacheTest) (l m g : Nat) : CacheTest :=
  cacheRun hit (cacheStep l m g)

theorem lookMemo_eq (hit : CacheTest) (l m g : Nat) (h : HitSound hit (look l m g)) :
    lookMemo hit l m g = look l m g :=
  cacheRun_eq hit (look l m g) (cacheStep l m g) rfl (fun _ => rfl) h

noncomputable def look1Memo (hit0 hit1 : CacheTest) (l m g K : Nat) : CacheTest :=
  cacheRun hit1 (cacheStep1 l m g (lookMemo hit0 l m g K))

theorem look1Memo_eq (hit0 hit1 : CacheTest) (l m g K : Nat)
    (h0 : HitSound hit0 (look l m g)) (h1 : HitSound hit1 (look1 l m g K)) :
    look1Memo hit0 hit1 l m g K = look1 l m g K := by
  unfold look1Memo
  rw [lookMemo_eq hit0 l m g h0]
  exact cacheRun_eq hit1 (look1 l m g K) _ rfl (fun _ => rfl) h1

noncomputable def topCMemo (hit0 hit1 : CacheTest) (l m g K H ph k t z : ℕ) (v : List W) : Bool :=
  Bool.rec (motive := fun _ => Bool) (tst (pos t) l (Nat.sub (Nat.succ k) t) v (fun y =>
    Bool.rec (motive := fun _ => Bool) (Bool.rec (motive := fun _ => Bool) false (mv (lookMemo hit0 l m g K) l m g k t z v y) (Nat.beq ph 1)) true
      (node (look1Memo hit0 hit1 l m g K K (Nat.sub k 1) t) (pos t) l m g (Nat.sub (Nat.sub k t) y) v.length z v (fun h xs => pairsC H h (fs xs))))) true (Nat.ble v.length 1)

theorem topCMemo_eq (hit0 hit1 : CacheTest) (l m g K : Nat)
    (h0 : HitSound hit0 (look l m g)) (h1 : HitSound hit1 (look1 l m g K)) :
    topCMemo hit0 hit1 l m g K = topC l m g K := by
  unfold topCMemo topC
  rw [look1Memo_eq hit0 hit1 l m g K h0 h1, lookMemo_eq hit0 l m g h0]

noncomputable def startvMemo (hit0 hit1 : CacheTest) (l m g B K t p H ph : ℕ) (v : List W) : Bool :=
  Bool.rec (motive := fun _ => Bool) false (Bool.rec (motive := fun _ => Bool) false
    (child (fun z r => topCMemo hit0 hit1 l m g K H ph K t z r) g (fun h => h v) (Nat.sub B (sumc v)))
    (Nat.ble v.length (Nat.sub (Nat.succ K) t))) (hasP p v)

theorem startvMemo_eq (hit0 hit1 : CacheTest) (l m g B K : Nat)
    (h0 : HitSound hit0 (look l m g)) (h1 : HitSound hit1 (look1 l m g K)) :
    startvMemo hit0 hit1 l m g B K = startv l m g B K := by
  unfold startvMemo startv
  rw [topCMemo_eq hit0 hit1 l m g K h0 h1]

noncomputable def chkMemo (hit0 hit1 : CacheTest) (E Q : List (ℕ × ℕ)) (Z K t H ph : ℕ) : Bool :=
  (fun l => (fun m => (fun P => (fun g => (fun B => (fun p =>
    frc (avl P m (rawL E)) (fun v => st l fun l => st m fun m => st g fun g => st B fun B => st p fun p =>
      anySub (pos t) l v 0 (fun r => startvMemo hit0 hit1 l m g B K t p H ph r)))
    (pwr E Z)) (pL (Q.map fun e => 16 + (K - e.2)))) (pL (Q.map fun _ => 16))) (PZ Q)) (mz Z)) (lz Z)

theorem chkMemo_eq (hit0 hit1 : CacheTest) (E Q : List (ℕ × ℕ)) (Z K t H ph : Nat)
    (h0 : HitSound hit0 (look (lz Z) (mz Z) (pL (Q.map fun _ => 16))))
    (h1 : HitSound hit1 (look1 (lz Z) (mz Z) (pL (Q.map fun _ => 16)) K)) :
    chkMemo hit0 hit1 E Q Z K t H ph = chk E Q Z K t H ph := by
  simp only [chkMemo, chk, st_eq]
  rw [startvMemo_eq hit0 hit1 _ _ _ _ K h0 h1]

abbrev CacheRouteTag := Nat → Nat → Nat → Nat → Bool
abbrev CacheBucket (α : Type) := Nat → Nat → Nat → Nat → List α

def guardHit (allow : CacheRouteTag) (base : CacheTest) : CacheTest :=
  fun f k t z ws => allow f k t z && base f k t z ws

theorem guardHit_sound (allow : CacheRouteTag) (base original : CacheTest)
    (h : HitSound base original) : HitSound (guardHit allow base) original := by
  intro f k t z ws hit
  simp only [guardHit, Bool.and_eq_true] at hit
  exact h f k t z ws hit.2

def cj (a b : Nat) : Nat := Nat.lor (Nat.shiftLeft a 64) b
def cg : Nat := pL (rt.map fun _ => 16)

def VK (f : CacheTest) := {q : CacheKey // f q.fuel q.k q.t q.z q.wires = false}
def hitVerified {f : CacheTest} (keys : List (VK f)) : CacheTest :=
  hitKeys (keys.map Subtype.val)
theorem hitVerified_sound {f : CacheTest} (keys : List (VK f)) : HitSound (hitVerified keys) f := by
  apply hitKeys_sound
  intro q hq
  obtain ⟨v, _, rfl⟩ := List.mem_map.mp hq
  exact v.property

