open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity
open PEqualNP.Outside.L_meta_18474.Core PEqualNP.Outside.L_meta_18474.Core.Readers

theorem pin {n : ℕ} (f : (Fin (n+1) → Bool) → Bool) (v : Fin (n+1)) (s : ℕ)
    (hc : HasCircuitSize (n+1) f s) (dep : Dep f v)
    (off : ∀ b : Bool, ∃ y, f (Function.update y v b) = false) :
    ∃ b : Bool, HasCircuitSize (n+1) (fun x => f (Function.update x v b)) (s-2) := by
  classical
  by_cases hnc : ∀ b : Bool, ∃ x y, f (Function.update x v b) ≠ f (Function.update y v b)
  · obtain ⟨gs,o,L,hlen⟩ := exists_least (n+1) f s (dep_nc dep) hc
    obtain ⟨p,hp⟩ := L.dep_read v dep hnc
    obtain ⟨g,hg,hread⟩ := hp
    let b := fixBit g
    have const := isC_reader L.hcl v p g hg hread b (Or.inr rfl)
    have read : Reads gs p v := ⟨g,hg,hread⟩
    obtain ⟨q,lt,_,rc⟩ := L.next v b (hnc b) p (reads_len read) const
    obtain ⟨z,hz,C,fan,sz,sem⟩ := L.save2 v b (hnc b) p q lt.ne (rc_input b read) rc
    exact ⟨b,C,fan,by omega,sem⟩
  · push Not at hnc
    obtain ⟨b,hb⟩ := hnc
    obtain ⟨y,hy⟩ := off b
    refine ⟨b,⟨[],n+1⟩,by simp [FanInTwo], Nat.zero_le _, ?_⟩
    intro x
    change (List.ofFn x).getD (n+1) false = _
    exact (List.getD_eq_default _ _ (by simp)).trans ((hb x y).trans hy).symm
end PEqualNP.Outside.L_meta_18474

theorem PEqualNP.Outside.L_meta_18474 : (∀ (n : ℕ) (C : PEqualNP.CircuitLowerBounds.Circuit) (v : Fin n) (s : ℕ), PEqualNP.MetaComplexity.FanInTwo C → (∀ g ∈ C.gates, g.op = PEqualNP.CircuitLowerBounds.GateOp.not → g.inputs.length = 1) → C.size ≤ s → (∃ x : Fin n → Bool, C.eval (List.ofFn (Function.update x v true)) ≠ C.eval (List.ofFn (Function.update x v false))) → (∃ y : Fin n → Bool, C.eval (List.ofFn (Function.update y v false)) = false) → (∃ y : Fin n → Bool, C.eval (List.ofFn (Function.update y v true)) = false) → (PEqualNP.MetaComplexity.HasCircuitSize n (fun x : Fin n → Bool => C.eval (List.ofFn (Function.update x v false))) (s - 2) ∨ PEqualNP.MetaComplexity.HasCircuitSize n (fun x : Fin n → Bool => C.eval (List.ofFn (Function.update x v true))) (s - 2))) := by
  intro n C v s fan _ size dep off on
  cases n with
  | zero => exact v.elim0
  | succ n =>
    let f := fun x : Fin (n+1) → Bool => C.eval (List.ofFn x)
    have hc : PEqualNP.MetaComplexity.HasCircuitSize (n+1) f s := ⟨C,fan,size,fun _ => rfl⟩
    have hd : PEqualNP.Outside.L_meta_18474.Core.Readers.Dep f v := by
      obtain ⟨x,h⟩ := dep
      refine ⟨Function.update x v false, ?_⟩
      simpa [f] using h
    obtain ⟨b,hb⟩ := PEqualNP.Outside.L_meta_18474.pin f v s hc hd (by intro b; cases b <;> assumption)
    cases b with
    | false => exact Or.inl hb
    | true => exact Or.inr hb
