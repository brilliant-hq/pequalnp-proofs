theorem tab_ok : ∀ t ∈ tab, t.1 ^^^ 12 = (t.2.map (fun p => p.2 ^^^ 12)).foldr (· ^^^ ·) 0 ∧
    t.2.length % 2 = 1 ∧ ∀ p ∈ t.2, p.1 ∈ negs ∧ p.2 < 2 ^ 17 ∧ p.2.testBit 2 = false ∧
      outputW fstep (p.2 ^^^ 12) = outputW fstep (t.1 ^^^ 12) ∧ passW fstep p.2 p.1 < 2 ^ 8 := by
  decide +kernel

